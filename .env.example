# Шаблон локальной конфигурации. Файл .env с реальными значениями не добавляйте в Git.
# Для Amvera создайте значения в проекте ossDemo: «Переменные и секреты».

# Обычные переменные (не содержат учётных данных).
# Эмбеддинги выполняются встроенной ONNX-моделью RAGify; внешний сервис minilm не требуется.
Docling__BaseUrl=https://docling-aleksandr12224411.amvera.io/
KnowledgeImport__Directory=/data/inbox
# Необязательный совместимый внутренний reranker endpoint. Если не задан, используется RRF.
# Rag__Reranker__Endpoint=http://internal-reranker/rerank

# Секреты: задаются только в Amvera или локально в переменных окружения.
AI__ApiToken=replace-with-amvera-llm-token
Docling__ApiKey=replace-with-the-docling-api-key
ConnectionStrings__OssDatabase=Host=amvera-aleksandr12224411-cnpg-oss-rw;Port=5432;Database=OSSDB;Username=aleksandr12224411;Password=replace-with-database-password;SSL Mode=Disable
