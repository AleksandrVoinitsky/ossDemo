@page
@model IndexModel
@{ 
    ViewData["Title"] = "Сводка ООС";
    ViewData["Nav"] = "Home";
    ViewData["Breadcrumb"] = "Главная \\ Сводка";
}

<section class="row g-3 mb-4">
    <div class="col-md-6 col-xl-3"><div class="metric-card"><div class="metric-label">Пункты проекта</div><div class="metric-value">42</div><div class="small text-muted">1 требует решения инспектора</div></div></div>
    <div class="col-md-6 col-xl-3"><div class="metric-card"><div class="metric-label">Источники БЗ</div><div class="metric-value">5</div><div class="small text-muted">нормативные и корпоративные документы</div></div></div>
    <div class="col-md-6 col-xl-3"><div class="metric-card"><div class="metric-label">Нарушения</div><div class="metric-value text-danger">1</div><div class="small text-muted">критический просроченный срок</div></div></div>
    <div class="col-md-6 col-xl-3"><div class="metric-card"><div class="metric-label">Разделы</div><div class="metric-value">7</div><div class="small text-muted">активная версия v2026.01</div></div></div>
</section>

<section class="row g-4 mb-4">
    <div class="col-xl-8">
        <div class="soft-panel p-3 p-lg-4 h-100">
            <div class="d-flex flex-wrap justify-content-between gap-3 mb-3">
                <div>
                    <h2 class="section-title h4 mb-1">Текущее состояние подготовки</h2>
                    <p class="muted-note mb-0">Контрольные данные по основному сценарию без рекламных и вводных блоков.</p>
                </div>
                <a class="btn btn-primary" asp-page="/Checklists/New">Открыть мастер</a>
            </div>
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead><tr><th>Контур</th><th>Состояние</th><th>Влияние на результат</th><th>Действие</th></tr></thead>
                    <tbody>
                        <tr><td><strong>График</strong><div class="small text-muted">Запись №18</div></td><td><span class="badge text-bg-success">сопоставлен</span></td><td>объект и период проверки определены</td><td><a asp-page="/Schedule">перейти</a></td></tr>
                        <tr><td><strong>Профиль объекта</strong><div class="small text-muted">Березниковское ЛПУМГ</div></td><td><span class="badge text-bg-success">готов</span></td><td>применимы разделы 1-7 классификатора</td><td><a asp-page="/Facilities">перейти</a></td></tr>
                        <tr><td><strong>ОРД проверки</strong><div class="small text-muted">3 документа</div></td><td><span class="badge text-bg-warning">есть решение</span></td><td>лицензия по скважине №3 требует проверки</td><td><a asp-page="/Documents">перейти</a></td></tr>
                        <tr><td><strong>Реестр нарушений</strong><div class="small text-muted">история за 5 лет</div></td><td><span class="badge text-bg-danger">критический пункт</span></td><td>добавлен контроль протоколов выбросов</td><td><a asp-page="/Violations">перейти</a></td></tr>
                        <tr><td><strong>Результат</strong><div class="small text-muted">проект чек-листа</div></td><td><span class="badge text-bg-primary">в работе</span></td><td>экспорт доступен после подтверждения</td><td><a asp-page="/Checklists/Result">перейти</a></td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-xl-4">
        <div class="soft-panel p-3 p-lg-4 h-100">
            <h2 class="section-title h4 mb-3">Оперативные события</h2>
            <div class="timeline compact-timeline">
                <div class="timeline-item"><strong>21:15 · Вопрос ИИ</strong><div class="small text-muted">ответ по критическому пункту с цитатами источников</div></div>
                <div class="timeline-item"><strong>21:13 · Пункт добавлен</strong><div class="small text-muted">ручное требование по журналу учета отходов</div></div>
                <div class="timeline-item"><strong>21:11 · Эскалация закрыта</strong><div class="small text-muted">пункт по лицензии включён решением инспектора</div></div>
                <div class="timeline-item mb-0"><strong>21:10 · Проект сформирован</strong><div class="small text-muted">агенты БЗ, ОРД, нарушений и истории завершили анализ</div></div>
            </div>
        </div>
    </div>
</section>

<section class="row g-3">
    <div class="col-md-6 col-xl-3"><a class="module-link" asp-page="/Classifier"><span>Классификатор</span><strong>65 критериев</strong></a></div>
    <div class="col-md-6 col-xl-3"><a class="module-link" asp-page="/KnowledgeBase"><span>База знаний</span><strong>5 источников</strong></a></div>
    <div class="col-md-6 col-xl-3"><a class="module-link" asp-page="/Templates"><span>Шаблоны</span><strong>филиал Пермь v2026</strong></a></div>
    <div class="col-md-6 col-xl-3"><a class="module-link" asp-page="/AuditLog"><span>Журнал</span><strong>8 событий</strong></a></div>
</section>
