@page
@model IndexModel
@{
    ViewData["Title"] = "Оперативная панель";
    ViewData["Nav"] = "Home";
    ViewData["Breadcrumb"] = "Главная / Оперативная панель";
    var dashboard = Model.Dashboard;
}

<section class="operations-header">
    <div>
        <p class="eyebrow mb-2">Контур инспекционного контроля</p>
        <h1 class="section-title h3 mb-2">Оперативная панель</h1>
        <p class="muted-note mb-0">Состояние реестров, приоритеты проверки и события рабочего контура.</p>
    </div>
    <div class="operations-header-actions">
        <a class="btn btn-outline-primary" asp-page="/KnowledgeBase">Открыть базу знаний</a>
        <button class="btn btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#aiConsultantModal">Новая команда</button>
    </div>
</section>

@if (dashboard == OperationalDashboard.Unavailable)
{
    <div class="alert alert-info mb-4" role="status">Рабочая PostgreSQL ещё не настроена. Панель доступна в режиме просмотра; для реестров и команд добавьте <code>ConnectionStrings__OssDatabase</code> в переменные окружения.</div>
}

<section class="operation-metrics" aria-label="Ключевые показатели">
    <article class="operation-metric-card">
        <span class="operation-metric-icon metric-icon-blue">ОБ</span>
        <div><span class="operation-metric-label">Объекты контроля</span><strong>@(dashboard?.FacilityCount ?? 0)</strong><a asp-page="/Facilities">Открыть реестр</a></div>
    </article>
    <article class="operation-metric-card">
        <span class="operation-metric-icon metric-icon-red">НШ</span>
        <div><span class="operation-metric-label">Открытые нарушения</span><strong>@(dashboard?.ViolationCount ?? 0)</strong><a asp-page="/Violations">Открыть реестр</a></div>
    </article>
    <article class="operation-metric-card">
        <span class="operation-metric-icon metric-icon-amber">!</span>
        <div><span class="operation-metric-label">Требуют решения</span><strong>@(dashboard?.AttentionCount ?? 0)</strong><a asp-page="/Checklists/New">Сформировать чек-лист</a></div>
    </article>
    <article class="operation-metric-card">
        <span class="operation-metric-icon metric-icon-green">RAG</span>
        <div><span class="operation-metric-label">База знаний</span><strong data-rag-document-count>—</strong><a asp-page="/KnowledgeBase">Источники и документы</a></div>
    </article>
</section>

<section class="row g-4">
    <div class="col-xl-7">
        <section class="soft-panel operational-panel h-100" aria-labelledby="priorityTitle">
            <div class="operational-panel-header"><div><p class="eyebrow mb-1">В фокусе</p><h2 id="priorityTitle" class="h5 section-title mb-0">Очередь инспектора</h2></div><a asp-page="/Violations" class="small">Все нарушения</a></div>
            <div class="priority-list">
                <a class="priority-item priority-critical" asp-page="/Violations"><span class="priority-state">Критично</span><div><strong>Проверить протокол инструментального контроля</strong><p>Березниковское ЛПУМГ · раздел 2.3 «Атмосфера»</p></div><span class="priority-arrow">→</span></a>
                <a class="priority-item" asp-page="/KnowledgeBase"><span class="priority-state priority-state-info">RAG</span><div><strong>Сверить новые документы перед подготовкой проверки</strong><p>Используйте базу знаний для поиска подтверждающих фрагментов.</p></div><span class="priority-arrow">→</span></a>
                <a class="priority-item" asp-page="/Checklists/New"><span class="priority-state priority-state-neutral">План</span><div><strong>Сформировать индивидуальный чек-лист</strong><p>Подбор требований и истории нарушений по выбранному объекту.</p></div><span class="priority-arrow">→</span></a>
            </div>
        </section>
    </div>
    <div class="col-xl-5">
        <section class="soft-panel operational-panel h-100" aria-labelledby="inspectionTitle">
            <div class="operational-panel-header"><div><p class="eyebrow mb-1">Рабочий контур</p><h2 id="inspectionTitle" class="h5 section-title mb-0">Объекты в реестре</h2></div><a asp-page="/Facilities" class="small">К объектам</a></div>
            <div class="inspection-list">
            @foreach (var inspection in dashboard?.Inspections ?? [])
            {
                <a class="inspection-row" asp-page="/Facilities"><span class="status-dot status-ready"></span><div><strong>@inspection.Name</strong><span>НВОС @inspection.NvocCategory · цифровой профиль</span></div><span>→</span></a>
            }
            </div>
        </section>
    </div>
    <div class="col-xl-8">
        <section class="soft-panel operational-panel" aria-labelledby="activityTitle">
            <div class="operational-panel-header"><div><p class="eyebrow mb-1">Прозрачность</p><h2 id="activityTitle" class="h5 section-title mb-0">Последние события</h2></div><a asp-page="/AuditLog" class="small">Журнал действий</a></div>
            <div class="activity-timeline">
            @foreach (var activity in dashboard?.Activity ?? [])
            {
                <div class="activity-row"><time>@activity.OccurredAt.LocalDateTime.ToString("dd.MM · HH:mm")</time><span class="activity-marker"></span><div><strong>@activity.Action</strong><p>@activity.Details</p></div></div>
            }
            </div>
        </section>
    </div>
    <div class="col-xl-4">
        <aside class="soft-panel command-panel" aria-labelledby="commandsTitle">
            <p class="eyebrow mb-1">Быстрый ввод</p><h2 id="commandsTitle" class="h5 section-title">Команды реестра</h2>
            <p class="muted-note small">Добавляйте объекты и нарушения прямо через ИИ-консультанта. Записи сохраняются в PostgreSQL и отображаются на панели.</p>
            <button class="command-example" type="button" data-chat-command="!help">!help</button>
            <code>!add-facility | Наименование | Адрес | I | 59.4072 | 56.8040</code>
            <code>!add-violation | Объект | Раздел | Текст | Ответственный | 2026-10-10 | review</code>
        </aside>
    </div>
</section>

@section Scripts {
    <script>
        fetch('/api/rag/status').then(response => response.ok ? response.json() : null).then(status => {
            const target = document.querySelector('[data-rag-document-count]');
            if (target && status) target.textContent = status.documentCount ?? '0';
        }).catch(() => {});
    </script>
}
