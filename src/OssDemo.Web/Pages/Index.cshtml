@page
@model IndexModel
@{ 
    ViewData["Title"] = "Нормативные новости";
    ViewData["Nav"] = "Home";
    ViewData["Breadcrumb"] = "Главная \\ Нормативные новости";
}

<section class="page-header mb-4">
    <div>
        <h1 class="section-title h2 mb-1">Нормативные новости ООС</h1>
        <p class="muted-note mb-0">Постановления, приказы, методические письма и внутренние объявления, влияющие на подготовку проверок и чек-листов.</p>
    </div>
    <div class="header-status">
        <span>Обновлено 21.08.2026 21:15</span>
    </div>
</section>

<section class="row g-4 news-workspace">
    <div class="col-xl-8">
        <section class="soft-panel" aria-labelledby="newsFeedTitle">
            <div class="strict-panel-header">
                <div>
                    <h2 id="newsFeedTitle" class="section-title h4 mb-1">Лента обновлений</h2>
                    <p class="muted-note mb-0">Документы и объявления, влияющие на состав требований и порядок контроля.</p>
                </div>
                <nav class="strict-filter" aria-label="Фильтр новостей">
                    <a href="#">Все</a>
                    <a href="#">Постановления</a>
                    <a href="#">Приказы</a>
                    <a href="#">Методика</a>
                </nav>
            </div>

            <div class="table-responsive">
                <table class="table strict-news-table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Дата</th>
                            <th>Тип</th>
                            <th>Содержание</th>
                            <th>Влияние</th>
                            <th>Статус</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><time datetime="2026-08-21">21.08.2026</time></td>
                            <td>Постановление</td>
                            <td>
                                <a asp-page="/KnowledgeBase">Обновлён порядок учёта требований производственного экологического контроля</a>
