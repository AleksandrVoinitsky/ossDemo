@page
@{
    ViewData["Title"] = "ОРД проверки";
    ViewData["Nav"] = "Documents";
    ViewData["Breadcrumb"] = "ОРД \\ Документы проверки";
}

<div class="page-actions mb-3">
    <button class="btn btn-primary" data-show-target="#uploadWarning">Загрузить файлы</button>
</div>

<div id="uploadWarning" class="alert alert-warning state-hidden" hidden>Поддерживаются PDF, DOCX, JPG и PNG. Ограничение загрузки — 50 МБ и 20 файлов за раз.</div>

<section class="row g-4">
    <div class="col-lg-5">
        <div class="soft-panel p-4 h-100">
            <h2 class="h4 section-title">Пакет документов</h2>
            <div class="list-group">
                <div class="list-group-item"><strong>Приказ об утверждении программы ПЭК</strong><div class="small text-muted">DOCX · распознан · влияет на разделы 1.4, 2.1, 3.2</div></div>
                <div class="list-group-item"><strong>Предписание по предыдущей проверке</strong><div class="small text-muted">PDF · распознан · добавляет контрольный пункт</div></div>
                <div class="list-group-item"><strong>Скан приложения к лицензии</strong><div class="small text-muted">JPG · сохранен как приложение, требуется проверка инспектора</div></div>
            </div>
        </div>
    </div>
    <div class="col-lg-7">
        <div class="soft-panel p-4">
            <h2 class="h4 section-title">Извлеченные влияния</h2>
            <div class="table-responsive"><table class="table align-middle"><thead><tr><th>Документ</th><th>Что найдено</th><th>Влияние</th><th>Статус</th></tr></thead><tbody>
                <tr><td>Приказ ПЭК</td><td>график инструментального контроля выбросов</td><td>добавить проверку протоколов замеров</td><td><span class="badge text-bg-success">принято</span></td></tr>
                <tr><td>Предписание</td><td>устранение замечания по месту накопления отходов</td><td>контрольный пункт в разделе 4.2</td><td><span class="badge text-bg-info">контрольный</span></td></tr>
                <tr><td>Лицензия</td><td>качество распознавания низкое</td><td>сохранить как приложение</td><td><span class="badge text-bg-warning">требует решения</span></td></tr>
            </tbody></table></div>
        </div>
    </div>
</section>
