@page
@{ ViewData["Title"] = "Нарушения"; ViewData["Nav"] = "Violations"; ViewData["Breadcrumb"] = "Нарушения"; }
<header class="page-header mb-4"><div><h1 class="h3 section-title mb-1">Нарушения</h1></div></header>
<section class="soft-panel p-3 p-lg-4" data-violation-documents>
    <form class="d-flex flex-wrap gap-2 mb-4" data-violation-upload><input class="form-control flex-grow-1" type="file" name="file" accept=".pdf,.doc,.docx,.xls,.xlsx" required><button class="btn btn-primary" type="submit">Загрузить документ</button></form>
    <div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Документ</th><th>Формат</th><th>Размер</th><th>Дата загрузки</th><th></th></tr></thead><tbody data-violation-documents-list></tbody></table></div>
    <p class="status-message status-message-muted mt-3 mb-0" data-violation-documents-status role="status"></p>
</section>
@section Scripts { <script src="~/js/violation-documents.js" asp-append-version="true"></script> }
