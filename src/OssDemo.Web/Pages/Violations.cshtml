@page
@{
    ViewData["Title"] = "Реестр нарушений";
    ViewData["Nav"] = "Violations";
}

<section class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
    <div>
        <span class="badge text-bg-danger mb-2">История проверок</span>
        <h1 class="section-title mb-1">Реестр нарушений и несоответствий</h1>
        <p class="muted-note mb-0">Повторные и просроченные нарушения усиливают состав будущего чек-листа.</p>
    </div>
    <button class="btn btn-outline-primary" data-file-action>Импортировать акт</button>
</section>

<section class="row g-4 mb-4">
    <div class="col-md-4"><div class="metric-card"><div class="metric-value">12</div><div class="small text-muted">нарушений за 5 лет</div></div></div>
    <div class="col-md-4"><div class="metric-card"><div class="metric-value">2</div><div class="small text-muted">повторные контрольные</div></div></div>
    <div class="col-md-4"><div class="metric-card"><div class="metric-value">1</div><div class="small text-muted">критический просроченный срок</div></div></div>
</section>

<section class="soft-panel p-3 p-lg-4">
    <div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Дата</th><th>Объект</th><th>Раздел</th><th>Формулировка</th><th>Ответственный</th><th>Срок</th><th>Статус</th></tr></thead><tbody>
        <tr><td>14.05.2025</td><td>Березниковское ЛПУМГ</td><td><span class="classifier-chip">4.2 Отходы</span></td><td>Нарушение маркировки места накопления отходов</td><td>Служба ООС</td><td>30.06.2025</td><td><span class="badge text-bg-info">контрольный</span></td></tr>
        <tr><td>22.09.2024</td><td>Березниковское ЛПУМГ</td><td><span class="classifier-chip">2.3 Атмосфера</span></td><td>Не представлен протокол инструментального контроля</td><td>Главный инженер</td><td>10.10.2024</td><td><span class="badge text-bg-danger">критический</span></td></tr>
        <tr><td>03.04.2023</td><td>Воткинское ЛПУМГ</td><td><span class="classifier-chip">5.1 Земля</span></td><td>Требуется уточнение границ площадки хранения</td><td>Начальник участка</td><td>20.05.2023</td><td><span class="badge text-bg-success">закрыто</span></td></tr>
        <tr><td>18.11.2022</td><td>Пермское ЛПУМГ</td><td><span class="classifier-chip">?</span></td><td>Классификация по разделу не определена</td><td>Инспектор</td><td>нет</td><td><span class="badge text-bg-warning">требует решения</span></td></tr>
    </tbody></table></div>
</section>
