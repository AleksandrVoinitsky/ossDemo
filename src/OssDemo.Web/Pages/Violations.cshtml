@page
@{
    ViewData["Title"] = "Реестр нарушений";
    ViewData["Nav"] = "Violations";
    ViewData["Breadcrumb"] = "Нарушения / Реестр";
}

<div class="page-actions mb-3 d-flex flex-wrap align-items-center justify-content-between gap-2">
    <div><h1 class="h3 section-title mb-1">Реестр нарушений</h1><p class="muted-note mb-0">Фактические записи из рабочей БД. Добавление — через ИИ-консультанта.</p></div>
</div>

<section class="soft-panel p-3 p-lg-4">
    <div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Дата</th><th>Объект</th><th>Раздел</th><th>Формулировка</th><th>Ответственный</th><th>Срок</th><th>Статус</th></tr></thead><tbody data-violations-list><tr><td colspan="7" class="text-muted">Загрузка реестра…</td></tr></tbody></table></div>
</section>

@section Scripts {
    <script src="~/js/operations.js" asp-append-version="true"></script>
}
