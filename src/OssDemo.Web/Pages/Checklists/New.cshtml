@page
@{
    ViewData["Title"] = "Новый чек-лист";
    ViewData["Nav"] = "Checklist";
}

<section class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
    <div>
        <span class="badge text-bg-primary mb-2">Happy path</span>
        <h1 class="section-title mb-1">Формирование индивидуального чек-листа</h1>
        <p class="muted-note mb-0">Demo workflow не вызывает внешний AI: результат подготовлен заранее и прозрачно показывает источники.</p>
    </div>
    <a class="btn btn-outline-primary" asp-page="/Checklists/Result">Открыть готовый результат</a>
</section>

<section class="row g-4">
    <div class="col-xl-8">
        <div class="soft-panel p-4 mb-4">
            <div class="row g-3">
                <div class="col-md-6"><label class="form-label">Запись графика</label><select class="form-select form-select-lg"><option>Березниковское ЛПУМГ · август 2026</option></select></div>
                <div class="col-md-6"><label class="form-label">Шаблон</label><select class="form-select form-select-lg"><option>Чек-лист уровня филиала Общества v2026</option></select></div>
                <div class="col-md-6"><label class="form-label">Объект</label><input class="form-control form-control-lg" value="Березниковское ЛПУМГ" /></div>
                <div class="col-md-6"><label class="form-label">Ответственный инспектор</label><input class="form-control form-control-lg" value="Дулаева Н. И." /></div>
            </div>
        </div>

        <div class="soft-panel p-4">
            <h2 class="h4 section-title">Проверка готовности</h2>
            <div class="row g-3 mb-4">
                <div class="col-md-6"><div class="workflow-step"><span class="step-number">1</span><div><strong>Профиль объекта</strong><div class="small text-success">Готов: все обязательные поля заполнены.</div></div></div></div>
                <div class="col-md-6"><div class="workflow-step"><span class="step-number">2</span><div><strong>Классификатор</strong><div class="small text-success">Активна версия v2026.01.</div></div></div></div>
                <div class="col-md-6"><div class="workflow-step"><span class="step-number">3</span><div><strong>База знаний</strong><div class="small text-success">5 источников с цитатами.</div></div></div></div>
                <div class="col-md-6"><div class="workflow-step"><span class="step-number">4</span><div><strong>ОРД и история</strong><div class="small text-warning">Есть 3 пункта для решения инспектора.</div></div></div></div>
            </div>
            <button class="btn btn-primary btn-lg" data-run-generation>Запустить demo-формирование</button>
            <div class="mt-4">
                <div class="demo-progress"><div class="demo-progress-bar" data-generation-progress></div></div>
                <div class="small muted-note mt-2" data-generation-status>Ожидает запуска.</div>
            </div>
            <div class="alert alert-success mt-4 demo-hidden" data-generation-result hidden>
                Проект создан: 42 пункта, 1 критический, 2 контрольных, 3 требуют решения. <a asp-page="/Checklists/Result" class="alert-link">Перейти к результату</a>.
            </div>
        </div>
    </div>
    <div class="col-xl-4">
        <div class="soft-panel p-4 h-100">
            <h2 class="h4 section-title">Источники формирования</h2>
            <div class="timeline">
                <div class="timeline-item"><strong>Классификатор</strong><div class="small text-muted">Коды разделов и причины включения.</div></div>
                <div class="timeline-item"><strong>База знаний</strong><div class="small text-muted">Нормативные цитаты и даты актуализации.</div></div>
                <div class="timeline-item"><strong>ОРД</strong><div class="small text-muted">Приказы, предписания, программы и планы.</div></div>
                <div class="timeline-item"><strong>Нарушения</strong><div class="small text-muted">Повторяемость и просроченные корректирующие действия.</div></div>
            </div>
        </div>
    </div>
</section>
