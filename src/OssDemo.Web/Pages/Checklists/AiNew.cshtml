@page
@{
    ViewData["Title"] = "ИИ-формирование чек-листа";
    ViewData["Nav"] = "AiChecklist";
    ViewData["Breadcrumb"] = "Чек-лист \\ ИИ-формирование";
}

<div class="page-actions mb-3">
    <a class="btn btn-outline-primary" asp-page="/Checklists/New">Обычное формирование</a>
    <a class="btn btn-outline-primary" asp-page="/Checklists/Archive">Шаблоны и история</a>
</div>

<section class="soft-panel checklist-wizard" data-ai-checklist-wizard>
    <div class="wizard-progress-area">
        <div class="d-flex flex-wrap justify-content-between gap-2">
            <span class="badge text-bg-primary" data-ai-wizard-status>Этап 1 из 5 · Объект</span>
            <span class="badge text-bg-warning">Эксперимент</span>
        </div>
        <div class="wizard-progress-line" aria-hidden="true"><div data-ai-wizard-progress></div></div>
    </div>

    <div class="wizard-panel active" data-ai-step="0">
        <div class="wizard-panel-header"><div><h1 class="h4 section-title mb-1">Шаг 1. Выберите объект</h1><p class="muted-note mb-0">Карточка и её признаки загружаются из рабочего реестра PostgreSQL.</p></div></div>
        <div class="wizard-card">
            <label class="form-label" for="aiFacility">Объект проверки</label>
            <select class="form-select form-select-lg" id="aiFacility" data-ai-facility><option value="">Загрузка объектов…</option></select>
            <div class="alert alert-danger mt-3 mb-0" data-ai-error hidden tabindex="-1"></div>
        </div>
        <div class="wizard-actions"><button class="btn btn-primary btn-lg" type="button" data-ai-analyze>Проанализировать карточку</button></div>
    </div>

    <div class="wizard-panel" data-ai-step="1" hidden>
        <div class="wizard-panel-header"><div><h2 class="h4 section-title mb-1">Шаг 2. Признаки объекта</h2><p class="muted-note mb-0">Проверьте поля карточки, по которым система определит применимые критерии классификатора.</p></div></div>
        <div class="row g-3" data-ai-profile></div>
        <div class="alert alert-danger mt-3 mb-0" data-ai-search-error hidden tabindex="-1"></div>
        <div class="wizard-actions"><button class="btn btn-outline-primary btn-lg" type="button" data-ai-prev>Назад</button><button class="btn btn-primary btn-lg" type="button" data-ai-search>Подобрать критерии</button></div>
    </div>

    <div class="wizard-panel" data-ai-step="2" hidden>
        <div class="wizard-panel-header"><div><h2 class="h4 section-title mb-1">Шаг 3. Применимые критерии</h2><p class="muted-note mb-0">Классификатор задал структуру будущего чек-листа. Для каждого критерия показана причина включения.</p></div><span class="badge text-bg-primary" data-ai-evidence-count>0 критериев</span></div>
        <div class="ai-selected-criteria" data-ai-evidence></div><div data-ai-queries hidden></div>
        <div class="wizard-actions"><button class="btn btn-outline-primary btn-lg" type="button" data-ai-prev>Назад</button><button class="btn btn-primary btn-lg" type="button" data-ai-next>Перейти к формированию</button></div>
    </div>

    <div class="wizard-panel" data-ai-step="3" hidden>
        <div class="wizard-panel-header"><div><h2 class="h4 section-title mb-1">Шаг 4. Сформировать проект</h2><p class="muted-note mb-0">Агент последовательно обрабатывает критерии: ищет статьи, проверяет цитаты и формулирует короткие действия.</p></div></div>
        <div class="generation-stage"><div class="generation-orbit" aria-hidden="true"><span></span><span></span><span></span></div><div><div class="d-flex flex-wrap justify-content-between gap-2"><strong data-ai-generation-title>Агент готов к запуску</strong><span class="muted-note">Прошло: <b data-ai-elapsed>00:00</b></span></div><p class="muted-note mb-2" data-ai-generation-status>Ограничений по времени нет. Все операции выполняются по одной.</p><div class="generation-progress"><div class="generation-progress-bar" data-ai-generation-progress></div></div></div></div>
        <div class="ai-live-metrics mt-3" aria-live="polite">
            <div><span>Общий прогресс</span><strong data-ai-total-progress>0 из 0</strong></div>
            <div><span>Проверено ИИ</span><strong class="text-success" data-ai-success-count>0</strong></div>
            <div><span>Базовые пункты</span><strong class="text-warning" data-ai-base-count>0</strong></div>
            <div><span>В очереди</span><strong data-ai-remaining-count>0</strong></div>
        </div>
        <div class="ai-live-workspace mt-3">
            <section class="ai-process-panel">
                <div class="ai-live-panel-head"><div><span class="eyebrow">Текущий критерий</span><h3 class="h5 mb-0" data-ai-current-criterion>Ожидает запуска</h3></div><span class="badge text-bg-primary" data-ai-current-code>—</span></div>
                <p class="ai-current-base" data-ai-current-base>После запуска здесь появится базовая формулировка из классификатора.</p>
                <ol class="ai-stage-list" data-ai-stage-list></ol>
            </section>
            <section class="ai-stream-panel">
                <div class="ai-live-panel-head"><div><span class="eyebrow">Живой ответ модели</span><h3 class="h5 mb-0">Рабочий текст агента</h3></div><span class="ai-stream-indicator" data-ai-stream-indicator>Ожидание</span></div>
                <pre class="ai-stream-output" data-ai-stream-output aria-live="polite">Ответ появится здесь по мере поступления от модели.</pre>
                <div class="ai-result-preview" data-ai-result-preview hidden><span>Итоговая формулировка</span><strong data-ai-result-preview-text></strong></div>
            </section>
        </div>
        <div class="ai-batch-grid mt-3" data-ai-batch-list></div>
        <div class="wizard-card mt-3"><h3 class="h6 section-title">Последние сформированные пункты</h3><ol class="ai-operation-log mb-0" data-ai-operation-log aria-live="polite"><li>Критерии сопоставлены с карточкой и ожидают запуска.</li></ol></div>
        <div class="alert alert-danger mt-3 mb-0" data-ai-generation-error hidden tabindex="-1"></div>
        <div class="wizard-actions"><button class="btn btn-outline-primary btn-lg" type="button" data-ai-prev>Назад</button><button class="btn btn-primary btn-lg" type="button" data-ai-generate>Сформировать ИИ-чек-лист</button><button class="btn btn-outline-danger btn-lg" type="button" data-ai-stop hidden>Остановить формирование</button><button class="btn btn-success btn-lg" type="button" data-ai-continue hidden>Перейти к чек-листу с доступными данными</button></div>
    </div>

    <div class="wizard-panel" data-ai-step="4" hidden>
        <div class="wizard-panel-header"><div><h2 class="h4 section-title mb-1">Шаг 5. Проект сохранён</h2><p class="muted-note mb-0">Дальше работает обычный цикл: редактирование, заполнение результатов, утверждение, история и экспорт.</p></div><span class="badge text-bg-success">Черновик</span></div>
        <div class="wizard-card"><table class="table compact-detail-table mb-0"><tbody><tr><th>Название</th><td data-ai-result-name>—</td></tr><tr><th>Объект</th><td data-ai-result-facility>—</td></tr><tr><th>Пунктов</th><td data-ai-result-count>—</td></tr><tr><th>Источник</th><td>Классификатор + карточка объекта + база знаний</td></tr></tbody></table></div>
        <div class="wizard-actions"><a class="btn btn-success btn-lg" data-ai-result-link>Открыть интерактивный чек-лист</a></div>
    </div>
</section>

@section Scripts { <script src="~/js/ai-checklists.js" asp-append-version="true"></script> }
