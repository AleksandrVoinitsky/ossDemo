@page
@{
    ViewData["Title"] = "Результат чек-листа";
    ViewData["Nav"] = "Checklist";
}

<section class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
    <div>
        <span class="badge text-bg-success mb-2">Проект сформирован</span>
        <h1 class="section-title mb-1">Индивидуальный чек-лист · Березниковское ЛПУМГ</h1>
        <p class="muted-note mb-0">Статусы и служебные метаданные видны инспектору, в печатную форму выводятся только нужные колонки.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <button class="btn btn-outline-primary" data-file-action>Скачать DOCX</button>
        <button class="btn btn-outline-primary" data-file-action>Скачать PDF</button>
        <button class="btn btn-outline-secondary" data-file-action>Скачать XLSX</button>
    </div>
</section>

<section class="row g-4 mb-4">
    <div class="col-md-3"><div class="metric-card"><div class="metric-value">42</div><div class="small text-muted">пункта всего</div></div></div>
    <div class="col-md-3"><div class="metric-card"><div class="metric-value">1</div><div class="small text-muted">критический</div></div></div>
    <div class="col-md-3"><div class="metric-card"><div class="metric-value">2</div><div class="small text-muted">контрольных</div></div></div>
    <div class="col-md-3"><div class="metric-card"><div class="metric-value">3</div><div class="small text-muted">требуют решения</div></div></div>
</section>

<section class="soft-panel p-3 p-lg-4 mb-4">
    <div class="d-flex flex-wrap justify-content-between gap-2 mb-3">
        <h2 class="h4 section-title mb-0">Пункты чек-листа</h2>
        <button class="btn btn-sm btn-primary" data-show-target="#manualItem">Добавить пункт вручную</button>
    </div>
    <div id="manualItem" class="alert alert-info state-hidden" hidden>Ручное добавление будет отмечено признаком «ручной пункт» и записано в журнал действий.</div>
    <div class="table-responsive"><table class="table align-middle"><thead><tr><th>№</th><th>Контролируемая позиция</th><th>Основание</th><th>Раздел</th><th>Статус</th><th>Причина включения</th><th></th></tr></thead><tbody>
        <tr><td>1</td><td>Наличие утвержденной программы производственного экологического контроля</td><td>ФЗ-7, программа ПЭК</td><td><span class="classifier-chip">1.4</span></td><td><span class="badge text-bg-success">обязательный</span></td><td>Профиль объекта + БЗ</td><td></td></tr>
        <tr class="checklist-row-critical"><td>8</td><td>Представлены протоколы инструментального контроля выбросов от стационарных источников</td><td>СТО 16-005-2025 п. 4.2</td><td><span class="classifier-chip">2.3</span></td><td><span class="badge text-bg-danger">критический</span></td><td>Просроченное нарушение 2024</td><td></td></tr>
        <tr class="checklist-row-control"><td>17</td><td>Проверить устранение замечания по маркировке места накопления отходов</td><td>Акт проверки 2025</td><td><span class="classifier-chip">4.2</span></td><td><span class="badge text-bg-info">контрольный</span></td><td>Повторяемость 2+ раза за 5 лет</td><td></td></tr>
        <tr class="checklist-row-decision"><td>23</td><td>Применим ли пункт по лицензии на пользование недрами для скважины №3?</td><td>Скан приложения к лицензии</td><td><span class="classifier-chip">6.1</span></td><td><span id="decision-status" class="badge text-bg-warning">требует решения</span></td><td>Низкое качество распознавания ОРД</td><td><button class="btn btn-sm btn-warning" data-resolve-item="#decision-status">Разрешить</button></td></tr>
        <tr><td>31</td><td>Наличие утвержденного ПНООЛР и соответствие фактических объемов лимитам</td><td>ФЗ-89 ст. 11, Приказ №792</td><td><span class="classifier-chip">4.3</span></td><td><span class="badge text-bg-success">обязательный</span></td><td>НВОС I + отходы</td><td></td></tr>
    </tbody></table></div>
</section>

<section class="row g-4">
    <div class="col-lg-6"><div class="soft-panel p-4 h-100"><h2 class="h4 section-title">Источники</h2><div class="pill-group"><span class="source-chip">ФЗ-7</span><span class="source-chip">ФЗ-89</span><span class="source-chip">СТО 16-005-2025</span><span class="source-chip">Приказ ПЭК</span><span class="source-chip">Акт 2025</span></div></div></div>
    <div class="col-lg-6"><div class="soft-panel p-4 h-100"><h2 class="h4 section-title">Ограничение статуса</h2><p class="muted-note mb-3">Чек-лист нельзя перевести в «Готов», пока есть пункты «Требует решения».</p><button class="btn btn-success">Сохранить проект</button></div></div>
</section>
