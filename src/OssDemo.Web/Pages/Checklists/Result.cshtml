@page
@{
    ViewData["Title"] = "Рабочий чек-лист";
    ViewData["Nav"] = "Checklist";
    ViewData["Breadcrumb"] = "Чек-лист \\ Рабочий";
}

<div class="page-actions mb-3"><a class="btn btn-outline-primary" asp-page="/Checklists/Archive">Шаблоны и история</a><span class="badge text-bg-primary align-self-center" data-working-status>Загрузка…</span></div>
<div class="alert state-hidden mb-3" role="alert" tabindex="-1" data-working-alert hidden></div>
<section class="soft-panel p-3 p-lg-4 mb-4 checklist-result-panel"><div class="d-flex flex-wrap justify-content-between gap-3 mb-3"><div><span class="checklist-result-kicker">Пункты чек-листа</span><h1 class="h4 section-title mb-1" data-working-title>Рабочий чек-лист</h1><p class="muted-note mb-0" data-working-meta></p></div><div class="working-actions"><div class="btn-group" data-export-links hidden><a class="btn btn-outline-primary" data-export-xlsx>Excel</a><a class="btn btn-outline-primary" data-export-docx>Word</a><a class="btn btn-outline-primary" data-export-pdf>PDF</a></div><button class="btn btn-outline-primary" data-draft-only data-show-target="#manualItem" type="button">Добавить пункт</button><button class="btn btn-success" data-draft-only data-open-approval type="button">Утвердить чек-лист</button></div></div>
    <div class="checklist-result-legend mb-3" aria-label="Цветовые обозначения"><span class="result-legend-item result-legend-success"><i></i>Основание найдено</span><span class="result-legend-item result-legend-danger"><i></i>Основание нужно проверить или заполнить</span></div>
    <div id="manualItem" class="soft-panel p-3 mb-3" data-draft-editor hidden><h2 class="h5 section-title">Новый пункт</h2><div class="row g-3 align-items-end"><div class="col-lg-5"><label class="form-label" for="manual-title">Наименование</label><input id="manual-title" class="form-control" data-manual-title /></div><div class="col-lg-3"><label class="form-label" for="manual-section">Раздел</label><input id="manual-section" class="form-control" data-manual-section value="Ручной пункт" /></div><div class="col-lg-4"><label class="form-label" for="manual-basis">Основание</label><input id="manual-basis" class="form-control" data-manual-basis /></div><div class="col-12"><label class="form-label" for="manual-note">Примечание</label><input id="manual-note" class="form-control" data-manual-note value="Добавлено инспектором" /></div><div class="col-12"><button class="btn btn-success" data-save-manual-item type="button">Сохранить пункт</button></div></div></div>
    <div class="checklist-result-list" data-working-checklist-body aria-live="polite"><div class="checklist-result-empty muted-note">Загрузка…</div></div>
</section>

<div class="modal fade" id="checklistApprovalModal" tabindex="-1" aria-labelledby="checklistApprovalTitle" aria-hidden="true"><div class="modal-dialog"><div class="modal-content"><div class="modal-header"><h2 class="modal-title h5" id="checklistApprovalTitle">Утвердить чек-лист?</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button></div><div class="modal-body">Перед утверждением исправьте все красные пункты, для которых не найдено подтверждённое основание. После утверждения чек-лист перейдёт в историю и станет доступен только для чтения.</div><div class="modal-footer"><button class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal">Отмена</button><button class="btn btn-success" type="button" data-confirm-approval>Утвердить</button></div></div></div></div>
<div class="modal fade" id="checklistItemEditModal" tabindex="-1" aria-labelledby="checklistItemEditTitle" aria-hidden="true"><div class="modal-dialog modal-lg"><form class="modal-content" data-edit-item-form><div class="modal-header"><h2 class="modal-title h5" id="checklistItemEditTitle">Редактировать пункт</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button></div><div class="modal-body"><div class="row g-3"><div class="col-12"><label class="form-label" for="edit-item-title">Наименование</label><textarea class="form-control" id="edit-item-title" rows="3" required data-edit-item-title></textarea></div><div class="col-md-5"><label class="form-label" for="edit-item-section">Раздел</label><input class="form-control" id="edit-item-section" required data-edit-item-section /></div><div class="col-md-7"><label class="form-label" for="edit-item-basis">Основание</label><textarea class="form-control" id="edit-item-basis" rows="2" required data-edit-item-basis></textarea></div><div class="col-12"><label class="form-label" for="edit-item-note">Примечание</label><textarea class="form-control" id="edit-item-note" rows="2" data-edit-item-note></textarea></div></div></div><div class="modal-footer"><button class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal">Отмена</button><button class="btn btn-primary" type="submit">Сохранить изменения</button></div></form></div></div>
<div class="modal fade" id="checklistItemDeleteModal" tabindex="-1" aria-labelledby="checklistItemDeleteTitle" aria-hidden="true"><div class="modal-dialog"><div class="modal-content"><div class="modal-header"><h2 class="modal-title h5" id="checklistItemDeleteTitle">Удалить пункт?</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button></div><div class="modal-body">Пункт <strong data-delete-item-name></strong> будет удалён из этого чек-листа.</div><div class="modal-footer"><button class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal">Отмена</button><button class="btn btn-danger" type="button" data-confirm-item-delete>Удалить</button></div></div></div></div>

@section Scripts { <script src="~/js/checklists.js" asp-append-version="true"></script> }
