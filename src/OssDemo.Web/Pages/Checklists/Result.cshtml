@page
@{
    ViewData["Title"] = "Рабочий чек-лист";
    ViewData["Nav"] = "Checklist";
    ViewData["Breadcrumb"] = "Чек-лист \\ Рабочий";
}

<div class="page-actions mb-3"><a class="btn btn-outline-primary" asp-page="/Checklists/Archive">Шаблоны и история</a><span class="badge text-bg-primary align-self-center" data-working-status>Загрузка…</span></div>
<div class="alert state-hidden mb-3" role="alert" tabindex="-1" data-working-alert hidden></div>
<section class="soft-panel p-3 p-lg-4 mb-4"><div class="d-flex flex-wrap justify-content-between gap-3 mb-3"><div><h1 class="h4 section-title mb-1" data-working-title>Рабочий чек-лист</h1><p class="muted-note mb-0" data-working-meta></p></div><div class="working-actions"><div class="btn-group" data-export-links hidden><a class="btn btn-outline-primary" data-export-xlsx>Excel</a><a class="btn btn-outline-primary" data-export-docx>Word</a><a class="btn btn-outline-primary" data-export-pdf>PDF</a></div><button class="btn btn-outline-primary" data-draft-only data-show-target="#manualItem" type="button">Добавить пункт</button><button class="btn btn-success" data-draft-only data-open-approval type="button">Утвердить чек-лист</button></div></div>
    <div id="manualItem" class="soft-panel p-3 mb-3" data-draft-editor hidden><h2 class="h5 section-title">Новый пункт</h2><div class="row g-3 align-items-end"><div class="col-lg-5"><label class="form-label" for="manual-title">Наименование</label><input id="manual-title" class="form-control" data-manual-title /></div><div class="col-lg-3"><label class="form-label" for="manual-section">Раздел</label><input id="manual-section" class="form-control" data-manual-section value="Ручной пункт" /></div><div class="col-lg-4"><label class="form-label" for="manual-basis">Основание</label><input id="manual-basis" class="form-control" data-manual-basis /></div><div class="col-12"><label class="form-label" for="manual-note">Примечание</label><input id="manual-note" class="form-control" data-manual-note value="Добавлено инспектором" /></div><div class="col-12"><button class="btn btn-success" data-save-manual-item type="button">Сохранить пункт</button></div></div></div>
    <div class="table-responsive"><table class="table align-middle"><thead><tr><th>№</th><th>Раздел</th><th>Наименование</th><th>Основание</th><th>Результат</th><th>Примечание</th><th>Источник</th></tr></thead><tbody data-working-checklist-body><tr><td colspan="7" class="muted-note">Загрузка…</td></tr></tbody></table></div>
</section>

<div class="modal fade" id="checklistApprovalModal" tabindex="-1" aria-labelledby="checklistApprovalTitle" aria-hidden="true"><div class="modal-dialog"><div class="modal-content"><div class="modal-header"><h2 class="modal-title h5" id="checklistApprovalTitle">Утвердить чек-лист?</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button></div><div class="modal-body">После утверждения чек-лист перейдёт в историю и станет доступен только для чтения.</div><div class="modal-footer"><button class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal">Отмена</button><button class="btn btn-success" type="button" data-confirm-approval>Утвердить</button></div></div></div></div>

@section Scripts { <script src="~/js/checklists.js" asp-append-version="true"></script> }
