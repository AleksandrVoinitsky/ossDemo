@page "/Schedule/Edit/{id?}"
@{
    var id = RouteData.Values["id"] as string;
    ViewData["Title"] = string.IsNullOrWhiteSpace(id) ? "Добавить событие" : "Редактировать событие";
    ViewData["Nav"] = "Schedule";
    ViewData["Breadcrumb"] = "График \\ Редактор события";
}

<div class="page-actions mb-3 d-flex flex-wrap justify-content-between gap-2">
    <div><h1 class="h3 section-title mb-1">@ViewData["Title"]</h1><p class="muted-note mb-0">Выберите объект из реестра, укажите период и ответственного.</p></div>
    <a class="btn btn-outline-primary" asp-page="/Schedule">Отмена</a>
</div>

<form class="vstack gap-4" data-schedule-editor data-schedule-event-id="@id">
    <div class="alert alert-danger" data-schedule-editor-error role="alert" tabindex="-1" hidden></div>
    <div class="soft-panel p-4"><h2 class="section-title h4 mb-3">Основные параметры</h2><div class="row g-3">
        <div class="col-12"><label class="form-label" for="title">Наименование события *</label><input class="form-control" id="title" name="title" required /></div>
        <div class="col-md-4"><label class="form-label" for="eventType">Тип события *</label><select class="form-select" id="eventType" name="eventType" required><option value="inspection">Плановая проверка</option><option value="control">Контрольный срок</option></select></div>
        <div class="col-md-4"><label class="form-label" for="status">Статус *</label><select class="form-select" id="status" name="status" required><option value="draft">В подготовке</option><option value="ready">Готово к генерации</option><option value="profile">Профиль требует доработки</option><option value="control">Контрольный срок</option></select></div>
        <div class="col-md-4"><label class="form-label" for="responsible">Ответственный *</label><input class="form-control" id="responsible" name="responsible" required /></div>
        <div class="col-md-6"><label class="form-label" for="facilitySlug">Объект *</label><select class="form-select" id="facilitySlug" name="facilitySlug" required data-facility-select><option value="">Загрузка объектов…</option></select></div>
        <div class="col-md-3"><label class="form-label" for="startDate">Дата начала *</label><input class="form-control" id="startDate" name="startDate" type="date" required /></div>
        <div class="col-md-3"><label class="form-label" for="endDate">Дата окончания *</label><input class="form-control" id="endDate" name="endDate" type="date" required /></div>
    </div></div>
    <div class="soft-panel p-4"><h2 class="section-title h4 mb-3">Содержание и готовность</h2><div class="row g-3">
        <div class="col-12"><label class="form-label" for="criteria">Охват и критерии контроля</label><textarea class="form-control" id="criteria" name="criteria" rows="3"></textarea></div>
        <div class="col-12"><label class="form-label" for="readiness">Готовность к проведению</label><textarea class="form-control" id="readiness" name="readiness" rows="3"></textarea></div>
        <div class="col-12"><label class="form-label" for="note">Примечание</label><textarea class="form-control" id="note" name="note" rows="3"></textarea></div>
    </div></div>
    <div class="d-flex flex-wrap gap-3"><button class="btn btn-primary" type="submit">Сохранить событие</button>@if (!string.IsNullOrWhiteSpace(id)) { <button class="btn btn-outline-danger" type="button" data-schedule-delete>Удалить событие</button> }</div>
</form>

@section Scripts { <script src="~/js/schedule-editor.js" asp-append-version="true"></script> }
