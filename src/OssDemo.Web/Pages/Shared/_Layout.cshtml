@{
    var breadcrumb = ViewData["Breadcrumb"] as string ?? ViewData["Title"] as string ?? "АИ ООС";
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - АИ ООС</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootswatch/minty/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/OssDemo.Web.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="app-frame">
        <aside class="app-sidebar" aria-label="Основное меню">
            <a class="app-brand" asp-area="" asp-page="/Index"><span class="brand-mark">ООС</span><span>АИ ООС</span></a>
            <div class="sidebar-caption">Рабочая область инспектора</div>
            <nav class="app-nav">
                <a class="nav-link @(ViewData["Nav"] as string == "Schedule" ? "active" : "")" asp-page="/Schedule">📅 <span>График</span></a>
                <a class="nav-link @(ViewData["Nav"] as string == "Checklist" ? "active" : "")" asp-page="/Checklists/New">📋 <span>Чек-лист</span></a>
                <a class="nav-link @(ViewData["Nav"] as string == "Knowledge" ? "active" : "")" asp-page="/KnowledgeBase">📚 <span>База знаний</span></a>
                <a class="nav-link @(ViewData["Nav"] as string == "Templates" ? "active" : "")" asp-page="/Templates">▦ <span>Шаблоны чек-листа</span></a>
                <a class="nav-link @(ViewData["Nav"] as string == "Classifier" ? "active" : "")" asp-page="/Classifier">⌘ <span>Классификатор</span></a>
                <a class="nav-link @(ViewData["Nav"] as string == "Facilities" ? "active" : "")" asp-page="/Facilities">🏭 <span>Объекты</span></a>
                <a class="nav-link @(ViewData["Nav"] as string == "Violations" ? "active" : "")" asp-page="/Violations">⚠️ <span>Нарушения</span></a>
            </nav>
            <div class="sidebar-footer">
                <a class="nav-link @(ViewData["Nav"] as string == "Audit" ? "active" : "")" asp-page="/AuditLog">Журнал действий</a>
                <a class="nav-link @(ViewData["Nav"] as string == "Profile" ? "active" : "")" asp-page="/Profile">Профиль инспектора</a>
                <form method="post" asp-page="/Login" asp-page-handler="Logout"><button class="nav-link sidebar-logout" type="submit">Выйти</button></form>
            </div>
        </aside>
        <div class="app-workspace">
            <header class="app-topbar">
                <a class="app-brand mobile-brand" asp-area="" asp-page="/Index"><span class="brand-mark">ООС</span><span>АИ ООС</span></a>
                <div class="topbar-data-status" aria-label="Статус актуальности данных"><span class="status-dot status-ready"></span><span>Данные актуальны</span><span class="text-muted">21.08.2026 21:15</span></div>
            </header>
            <div class="app-breadcrumb-bar" aria-label="Текущее расположение"><div class="app-breadcrumb-container">@breadcrumb</div></div>
            <div class="app-content">
                <main role="main" class="app-shell">@RenderBody()</main>
                <footer class="footer text-muted"><div class="d-flex flex-wrap justify-content-between gap-2"><span>&copy; 2026 — АИ ООС</span><span><a asp-area="" asp-page="/Privacy">О системе</a></span></div></footer>
            </div>
        </div>
    </div>

    <button class="ai-widget-button" type="button" data-bs-toggle="modal" data-bs-target="#aiConsultantModal" aria-label="Открыть ИИ-консультанта">
        <span class="ai-widget-button-icon" aria-hidden="true">AI</span>
        <span class="ai-widget-button-text">ИИ-консультант</span>
    </button>

    <div class="modal fade ai-consultant-modal" id="aiConsultantModal" tabindex="-1" aria-labelledby="aiConsultantModalTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-end modal-dialog-scrollable modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <div>
                        <h2 class="modal-title h5 section-title mb-1" id="aiConsultantModalTitle">ИИ-консультант</h2>
                        <div class="small muted-note">Контекст: Березниковское ЛПУМГ, НВОС I, подготовка проверки</div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
                </div>
                <div class="modal-body p-0">
                    <section class="chat-shell ai-widget-chat" aria-label="Чат с ИИ-консультантом">
                        <div class="chat-thread" data-chat-thread aria-live="polite" aria-label="История сообщений"></div>

                        <form data-ai-question data-ai-endpoint="/api/ai/chat" class="chat-input" autocomplete="off">
                            <label class="visually-hidden" for="ai-question-input">Вопрос ИИ-консультанту</label>
                            <textarea id="ai-question-input" class="form-control chat-textarea" data-chat-input rows="1" placeholder="Введите вопрос..." aria-label="Вопрос ИИ-консультанту"></textarea>
                            <div class="chat-composer-actions">
                                <button class="btn btn-primary" data-chat-send type="submit">Отправить</button>
                            </div>
                        </form>
                    </section>
                </div>
            </div>
        </div>
    </div>

    <template data-chat-message-template>
        <article class="chat-message" data-chat-message>
            <div class="chat-avatar" data-chat-avatar aria-hidden="true"></div>
            <div class="chat-bubble">
                <div class="chat-author" data-chat-author></div>
                <div class="chat-markdown" data-chat-markdown></div>
                <div class="pill-group chat-sources" data-ai-sources hidden></div>
            </div>
        </article>
    </template>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/dompurify/dist/purify.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
    @await RenderSectionAsync("VendorScripts", required: false)
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
