@{
    var breadcrumb = ViewData["Breadcrumb"] as string ?? ViewData["Title"] as string ?? "АИ ООС";
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - АИ ООС</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootswatch/minty/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/OssDemo.Web.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="app-frame">
        <aside class="app-sidebar" aria-label="Основное меню">
            <a class="app-brand" asp-area="" asp-page="/Index"><img class="brand-mark" src="~/images/app-logo.jpg" asp-append-version="true" alt="Логотип АИ ООС" /><span><b>АИ ООС</b><small>Инспекционный контур</small></span></a>
            <div class="sidebar-caption">Рабочие модули</div>
            <nav class="app-nav">
                <a class="nav-link @(ViewData["Nav"] as string == "Schedule" ? "active" : "")" asp-page="/Schedule"><i aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M7 2v3m10-3v3M4 9h16M5 5h14a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Zm3 8h3v3H8v-3Z" /></svg></i><span>График</span></a>
                <a class="nav-link @(ViewData["Nav"] as string == "Checklist" ? "active" : "")" asp-page="/Checklists/New"><i aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M9 4h8a2 2 0 0 1 2 2v14H5V6a2 2 0 0 1 2-2h2Zm-2 7 2 2 3-3m2 2h3m-3 4h3" /></svg></i><span>Чек-лист</span></a>
                <a class="nav-link @(ViewData["Nav"] as string == "Knowledge" ? "active" : "")" asp-page="/KnowledgeBase"><i aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H12v17H6.5A2.5 2.5 0 0 0 4 22V5.5Zm16 0A2.5 2.5 0 0 1 20 22V5.5Z" /></svg></i><span>База знаний</span></a>
                <a class="nav-link @(ViewData["Nav"] as string == "Facilities" ? "active" : "")" asp-page="/Facilities"><i aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 21V5l8-3 8 3v16M8 21v-5h8v5M8 8h.01M12 8h.01M16 8h.01M8 12h.01M12 12h.01M16 12h.01" /></svg></i><span>Объекты</span></a>
                <a class="nav-link @(ViewData["Nav"] as string == "Violations" ? "active" : "")" asp-page="/Violations"><i aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 3 2.8 20h18.4L12 3Zm0 6v5m0 3h.01" /></svg></i><span>Нарушения</span></a>
            </nav>
            <div class="sidebar-footer">
                <a class="nav-link @(ViewData["Nav"] as string == "Audit" ? "active" : "")" asp-page="/AuditLog"><i aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 8v5l3 2m5-3a8 8 0 1 1-2.34-5.66" /></svg></i><span>Журнал действий</span></a>
                <a class="nav-link @(ViewData["Nav"] as string == "Profile" ? "active" : "")" asp-page="/Profile"><i aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M20 21a8 8 0 0 0-16 0m12-13a4 4 0 1 1-8 0 4 4 0 0 1 8 0Z" /></svg></i><span>Профиль инспектора</span></a>
                <form method="post" asp-page="/Login" asp-page-handler="Logout"><button class="nav-link sidebar-logout" type="submit"><i aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M10 17l5-5-5-5m5 5H3m9-8h6a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-6" /></svg></i><span>Выйти</span></button></form>
            </div>
        </aside>
        <div class="app-workspace">
            <div class="app-breadcrumb-bar" aria-label="Текущее расположение"><div class="app-breadcrumb-container">@breadcrumb</div></div>
            <div class="app-content">
                <main role="main" class="app-shell">@RenderBody()</main>
                <footer class="footer text-muted"><div class="app-footer-content"><span>&copy; 2026 — АИ ООС</span><a asp-area="" asp-page="/Privacy">О системе</a><span aria-hidden="true"></span></div></footer>
            </div>
        </div>
    </div>

    <button class="ai-widget-button" type="button" data-bs-toggle="modal" data-bs-target="#aiConsultantModal" aria-label="Открыть ИИ-консультанта">
        <img class="ai-widget-button-icon" src="~/images/app-logo.jpg" asp-append-version="true" alt="" aria-hidden="true" />
        <span class="ai-widget-button-text">ИИ-консультант</span>
    </button>

    <div class="modal fade ai-consultant-modal" id="aiConsultantModal" tabindex="-1" aria-labelledby="aiConsultantModalTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-end modal-dialog-scrollable modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <div>
                        <h2 class="modal-title h5 section-title mb-1" id="aiConsultantModalTitle">ИИ-консультант</h2>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
                </div>
                <div class="modal-body p-0">
                    <section class="chat-shell ai-widget-chat" aria-label="Чат с ИИ-консультантом">
                        <div class="chat-thread" data-chat-thread aria-live="polite" aria-label="История сообщений"></div>

                        <form data-ai-question data-ai-endpoint="/api/ai/chat" class="chat-input" autocomplete="off">
                            <label class="visually-hidden" for="ai-question-input">Вопрос ИИ-консультанту</label>
                            <textarea id="ai-question-input" class="form-control chat-textarea" data-chat-input rows="1" placeholder="Введите вопрос…" aria-label="Вопрос ИИ-консультанту"></textarea>
                            <div class="chat-composer-actions">
                                <button class="btn btn-primary" data-chat-send type="submit">Отправить</button>
                            </div>
                        </form>
                    </section>
                </div>
            </div>
        </div>
    </div>

    <template data-chat-message-template>
        <article class="chat-message" data-chat-message>
            <div class="chat-avatar" data-chat-avatar><img src="~/images/app-logo.jpg" asp-append-version="true" alt="ИИ-консультант" /></div>
            <div class="chat-bubble">
                <div class="chat-author" data-chat-author></div>
                <div class="chat-markdown" data-chat-markdown></div>
                <div class="pill-group chat-sources" data-ai-sources hidden></div>
            </div>
        </article>
    </template>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/dompurify/dist/purify.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
    @await RenderSectionAsync("VendorScripts", required: false)
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
