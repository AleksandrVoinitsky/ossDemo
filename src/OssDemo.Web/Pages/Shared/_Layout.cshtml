<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - АИ ООС</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootswatch/minty/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/OssDemo.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="app-frame">
        <aside class="app-sidebar" aria-label="Основное меню">
            <a class="app-brand" asp-area="" asp-page="/Index">
                <span class="brand-mark">ООС</span>
                <span>АИ ООС</span>
            </a>
            <nav class="sidebar-nav">
                <a class="sidebar-link @(ViewData["Nav"] as string == "Home" ? "active" : "")" asp-area="" asp-page="/Index">Главная</a>
                <a class="sidebar-link @(ViewData["Nav"] as string == "Schedule" ? "active" : "")" asp-area="" asp-page="/Schedule">График</a>
                <a class="sidebar-link @(ViewData["Nav"] as string == "Facilities" ? "active" : "")" asp-area="" asp-page="/Facilities">Объекты</a>
                <a class="sidebar-link @(ViewData["Nav"] as string == "Classifier" ? "active" : "")" asp-area="" asp-page="/Classifier">Классификатор</a>
                <a class="sidebar-link @(ViewData["Nav"] as string == "Knowledge" ? "active" : "")" asp-area="" asp-page="/KnowledgeBase">База знаний</a>
                <a class="sidebar-link @(ViewData["Nav"] as string == "Documents" ? "active" : "")" asp-area="" asp-page="/Documents">ОРД</a>
                <a class="sidebar-link @(ViewData["Nav"] as string == "Violations" ? "active" : "")" asp-area="" asp-page="/Violations">Нарушения</a>
                <a class="sidebar-link @(ViewData["Nav"] as string == "Templates" ? "active" : "")" asp-area="" asp-page="/Templates">Шаблоны</a>
                <a class="sidebar-link @(ViewData["Nav"] as string == "Checklist" ? "active" : "")" asp-area="" asp-page="/Checklists/New">Чек-лист</a>
                <a class="sidebar-link @(ViewData["Nav"] as string == "Ai" ? "active" : "")" asp-area="" asp-page="/AiConsultant">AI-консультант</a>
                <a class="sidebar-link @(ViewData["Nav"] as string == "Audit" ? "active" : "")" asp-area="" asp-page="/AuditLog">Журнал</a>
            </nav>
            <div class="sidebar-footer">
                <div class="small text-muted mb-2">Пользователь: inspector</div>
                <form method="post" asp-page="/Login" asp-page-handler="Logout">
                    <button class="btn btn-outline-secondary btn-sm w-100" type="submit">Выйти</button>
                </form>
            </div>
        </aside>

        <div class="app-content">
            <main role="main" class="app-shell">
                @RenderBody()
            </main>
            <footer class="footer text-muted">
                <div class="d-flex flex-wrap justify-content-between gap-2">
                    <span>&copy; 2026 — АИ ООС</span>
                    <span><a asp-area="" asp-page="/Privacy">О системе</a></span>
                </div>
            </footer>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
