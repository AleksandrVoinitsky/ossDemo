@page
@{
    ViewData["Title"] = "Объекты контроля";
    ViewData["Nav"] = "Facilities";
    ViewData["Breadcrumb"] = "Объекты \\ Реестр и цифровые профили";
}

<header class="page-header mb-4">
    <div><h1 class="h3 section-title mb-1">Объекты контроля</h1><p class="muted-note mb-0">Реестр ведётся в рабочей базе данных.</p></div>
    <a class="btn btn-primary" asp-page="/FacilityEdit">Создать объект</a>
</header>

<section class="facility-workspace">
    <div class="soft-panel p-3 p-lg-4 facility-list-panel">
        <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
            <div>
                <h2 class="section-title h4 mb-1">Объекты проверки</h2>
                <p class="muted-note mb-0">Выберите объект, чтобы показать его на карте и открыть цифровой профиль.</p>
            </div>
            <div class="d-flex flex-wrap align-items-center gap-2"><label class="visually-hidden" for="facilitySearch">Найти объект</label><input class="form-control form-control-sm facility-search" id="facilitySearch" type="search" placeholder="Найти объект" data-facility-search /><span class="badge text-bg-primary" data-facility-count>—</span></div>
        </div>

        <div class="facility-list" aria-label="Объекты" data-facility-list></div>
        <p class="status-message status-message-muted mt-3 mb-0" data-facility-status role="status" aria-live="polite">Загрузка объектов…</p>
    </div>

    <div class="soft-panel p-3 p-lg-4 facility-map-panel">
        <div class="facility-map-shell">
            <iframe class="facility-yandex-map" src="about:blank" title="Расположение объекта на карте" loading="lazy" data-facility-map-frame></iframe>
        </div>
        <div class="facility-map-caption mt-3" aria-live="polite">
            <strong data-facility-map-name>Загрузка объектов…</strong>
            <span data-facility-map-address></span>
            <span data-facility-map-coordinates></span>
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/js/operations.js" asp-append-version="true"></script>
}
