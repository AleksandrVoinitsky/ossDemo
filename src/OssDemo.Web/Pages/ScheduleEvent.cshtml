@page "/Schedule/Event/{id?}"
@{
    var id = RouteData.Values["id"] as string;
    ViewData["Title"] = "Событие графика";
    ViewData["Nav"] = "Schedule";
    ViewData["Breadcrumb"] = "График \\ Событие";
}

<div class="page-actions mb-3 d-flex flex-wrap justify-content-between gap-2">
    <a class="btn btn-outline-primary" asp-page="/Schedule">Назад к графику</a>
    <div class="d-flex gap-2"><a class="btn btn-outline-primary" href="/Schedule/Edit/@id">Редактировать</a><a class="btn btn-primary" asp-page="/Checklists/New">Создать чек-лист</a></div>
</div>

<div data-schedule-event data-schedule-event-id="@id">
<section class="soft-panel p-4 mb-4">
    <div class="d-flex flex-wrap justify-content-between gap-3 mb-4">
        <div>
            <p class="eyebrow mb-1">Карточка события графика</p>
            <h1 class="section-title h2 mb-1" data-field="title">Загрузка…</h1>
            <p class="muted-note mb-0" data-event-type></p>
        </div>
        <span class="badge align-self-start" data-event-status></span>
    </div>

    <dl class="row g-3 mb-0">
        <div class="col-md-4"><dt class="small text-muted">Период</dt><dd class="fw-semibold mb-0" data-event-period></dd></div>
        <div class="col-md-4"><dt class="small text-muted">Объект</dt><dd class="fw-semibold mb-0" data-field="facilityName"></dd></div>
        <div class="col-md-4"><dt class="small text-muted">Ответственный</dt><dd class="fw-semibold mb-0" data-field="responsible"></dd></div>
    </dl>
</section>

<section class="row g-4">
    <div class="col-lg-7">
        <div class="soft-panel p-4 h-100">
            <h2 class="section-title h4 mb-3">Параметры события</h2>
            <dl class="schedule-detail-list">
                <div><dt>Охват и критерии контроля</dt><dd data-field="criteria"></dd></div>
                <div><dt>Готовность к проведению</dt><dd data-field="readiness"></dd></div>
            </dl>
        </div>
    </div>

    <div class="col-lg-5">
        <aside class="soft-panel p-4 h-100">
            <h2 class="section-title h4 mb-3">Примечание</h2>
            <p class="muted-note" data-field="note"></p>
            <div class="d-grid">
                <a class="btn btn-primary btn-lg" asp-page="/Checklists/New">Создать чек-лист</a>
            </div>
        </aside>
    </div>
</section>
<div class="alert alert-danger mt-4" data-schedule-event-error hidden></div>
</div>

@section Scripts { <script src="~/js/schedule-event.js" asp-append-version="true"></script> }
