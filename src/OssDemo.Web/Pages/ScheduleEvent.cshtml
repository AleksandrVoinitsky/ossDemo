            "Подготовить чек-лист",
            "/Checklists/New")
    };
    var currentEvent = events.FirstOrDefault(item => item.Id == id) ?? events[0];
    var ruCulture = CultureInfo.GetCultureInfo("ru-RU");

    ViewData["Title"] = currentEvent.Title;
    ViewData["Nav"] = "Schedule";
    ViewData["Breadcrumb"] = $"График \\ Событие \\ {currentEvent.Object}";
}

<div class="page-actions mb-3">
    <a class="btn btn-outline-primary" asp-page="/Schedule">Назад к графику</a>
    <a class="btn btn-primary" href="@currentEvent.ActionUrl">@currentEvent.ActionLabel</a>
</div>

<section class="soft-panel p-4 mb-4">
    <div class="d-flex flex-wrap justify-content-between gap-3 mb-4">
        <div>
            <h1 class="section-title h2 mb-1">@currentEvent.Title</h1>
            <p class="muted-note mb-0">@currentEvent.ObjectType</p>
        </div>
        <span class="badge @currentEvent.BadgeClass align-self-start">@currentEvent.Status</span>
    </div>

    <dl class="row g-3 mb-4">
        <div class="col-md-3"><dt class="small text-muted">Дата и время</dt><dd class="fw-semibold mb-0">@currentEvent.Start.ToString("dd MMMM yyyy, HH:mm", ruCulture)</dd></div>
        <div class="col-md-3"><dt class="small text-muted">Окончание</dt><dd class="fw-semibold mb-0">@currentEvent.End.ToString("dd MMMM yyyy, HH:mm", ruCulture)</dd></div>
        <div class="col-md-3"><dt class="small text-muted">Тип события</dt><dd class="fw-semibold mb-0">@currentEvent.Category</dd></div>
        <div class="col-md-3"><dt class="small text-muted">Ответственный</dt><dd class="fw-semibold mb-0">@currentEvent.Responsible</dd></div>
    </dl>

    <div class="alert alert-info mb-0">@currentEvent.Note</div>
</section>

<section class="row g-4">
    <div class="col-lg-7">
        <div class="soft-panel p-4 h-100">
            <h2 class="section-title h4 mb-3">Данные события</h2>
            <dl class="schedule-detail-list">
                <div><dt>Объект</dt><dd>@currentEvent.Object</dd></div>
                <div><dt>Критерии</dt><dd>@currentEvent.Criteria</dd></div>
                <div><dt>Сопоставление</dt><dd>@currentEvent.Match</dd></div>
            </dl>
        </div>
    </div>

    <div class="col-lg-5">
        <aside class="soft-panel p-4 h-100">
            <h2 class="section-title h4 mb-3">Действие</h2>
            <p class="muted-note">Перейдите к следующему рабочему шагу по этому событию.</p>
            <div class="d-grid">
                <a class="btn btn-primary btn-lg" href="@currentEvent.ActionUrl">@currentEvent.ActionLabel</a>
            </div>
        </aside>
    </div>
</section>

@functions {
    private sealed record ScheduleEvent(
        string Id,
        string Title,
        DateTime Start,
        DateTime End,
        string Status,
        string BadgeClass,
        string Category,
        string Object,
        string ObjectType,
        string Responsible,
        string Criteria,
        string Match,
        string Note,
        string ActionLabel,
        string ActionUrl);
}
