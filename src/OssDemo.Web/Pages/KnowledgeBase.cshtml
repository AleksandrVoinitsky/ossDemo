@page
@{
    ViewData["Title"] = "База знаний";
    ViewData["Nav"] = "Knowledge";
    ViewData["Breadcrumb"] = "База знаний \\ Рабочая область";
}

<div class="knowledge-page" data-knowledge-workspace>
    <section class="knowledge-toolbar" aria-label="Панель инструментов базы знаний">
        <div class="knowledge-breadcrumb" data-workspace-breadcrumb></div>
        <div class="input-group knowledge-search">
            <span class="input-group-text">⌕</span>
            <input class="form-control" type="search" placeholder="Поиск файлов и папок" aria-label="Поиск файлов и папок" data-workspace-search />
        </div>
    </section>

    <section class="knowledge-file-manager soft-panel" aria-label="Проводник базы знаний">
        <div class="knowledge-content-header">
            <button class="knowledge-icon-button" type="button" data-workspace-up aria-label="Назад на уровень выше" title="Назад">
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M15.5 5.5 9 12l6.5 6.5-1.7 1.7L5.6 12l8.2-8.2 1.7 1.7Z" /></svg>
            </button>
            <div class="knowledge-view-actions" aria-label="Вид файлов">
                <button class="knowledge-icon-button active" type="button" data-view-mode="grid" aria-label="Плитка" title="Плитка">
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 4h7v7H4V4Zm9 0h7v7h-7V4ZM4 13h7v7H4v-7Zm9 0h7v7h-7v-7Z" /></svg>
                </button>
                <button class="knowledge-icon-button" type="button" data-view-mode="list" aria-label="Список" title="Список">
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 6.5h14v2H5v-2Zm0 4.5h14v2H5v-2Zm0 4.5h14v2H5v-2Z" /></svg>
                </button>
            </div>
        </div>

        <div class="knowledge-items knowledge-items-grid" data-workspace-items></div>
        <div class="knowledge-empty d-none" data-workspace-empty>Ничего не найдено</div>
    </section>

    <div class="modal fade knowledge-document-modal" id="knowledgeDocumentModal" tabindex="-1" aria-labelledby="knowledgeDocumentTitle" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <div>
                        <h2 class="modal-title h5" id="knowledgeDocumentTitle" data-document-title></h2>
                        <div class="muted-note small" data-document-path></div>
                    </div>
                    <div class="knowledge-modal-actions">
                        <button type="button" class="knowledge-icon-button" data-print-document aria-label="Печать" title="Печать">
                            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M7 3h10v5H7V3Zm-2 7h14a3 3 0 0 1 3 3v5h-4v3H6v-3H2v-5a3 3 0 0 1 3-3Zm3 9h8v-5H8v5Zm11-5.8a1.2 1.2 0 1 0-2.4 0 1.2 1.2 0 0 0 2.4 0Z" /></svg>
                        </button>
                        <button type="button" class="knowledge-icon-button" data-bs-dismiss="modal" aria-label="Закрыть" title="Закрыть">
                            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m6.4 5 5.6 5.6L17.6 5 19 6.4 13.4 12l5.6 5.6-1.4 1.4-5.6-5.6L6.4 19 5 17.6l5.6-5.6L5 6.4 6.4 5Z" /></svg>
                        </button>
                    </div>
                </div>
                <div class="modal-body">
                    <div class="knowledge-document-meta mb-3">
                        <span class="muted-note small" data-document-updated></span>
                    </div>
                    <article class="markdown-preview knowledge-print-area" data-document-content></article>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.knowledgeWorkspace = {
            name: "База знаний",
            type: "folder",
            children: [
                {
                    name: "Нормативные документы",
                    type: "folder",
                    children: [
                        { name: "Федеральные законы", type: "folder", children: [
                            { name: "7-ФЗ Об охране окружающей среды.md", type: "file", status: "Индексировано", updated: "21.08.2026", content: "# 7-ФЗ «Об охране окружающей среды»\n\n## Область применения\nДокумент содержит базовые требования по охране окружающей среды и производственному экологическому контролю.\n\n## Фрагмент для поиска\nПриродопользователь обязан соблюдать утверждённые нормативы и вести учёт воздействия на окружающую среду.\n\n> Источник: статья 67, демонстрационная выдержка." },
                            { name: "89-ФЗ Об отходах производства и потребления.md", type: "file", status: "Индексировано", updated: "21.08.2026", content: "# 89-ФЗ «Об отходах производства и потребления»\n\n## Область применения\nДокумент используется для требований к образованию, накоплению и размещению отходов.\n\n## Фрагмент для поиска\nОрганизация должна обеспечивать учёт отходов и соблюдение установленных требований при обращении с ними.\n\n> Источник: статья 11, демонстрационная выдержка." }
                        ]},
                        { name: "Стандарты и СТО", type: "folder", children: [
                            { name: "СТО 16-005-2025 Обращение с отходами.md", type: "file", status: "Индексировано", updated: "20.08.2026", content: "# СТО 16-005-2025\n\n## Контроль обращения с отходами\nПроверяется наличие мест накопления, маркировки контейнеров и документов учёта.\n\n## Связь с классификатором\nРаздел 4.3 — нормативы образования отходов и лимиты размещения.\n\n> Источник: раздел 5.3.2, демонстрационная выдержка." }
                        ]}
                    ]
                },
                {
                    name: "Корпоративные документы",
                    type: "folder",
                    children: [
                        { name: "Программа ПЭК Березниковского ЛПУМГ.md", type: "file", status: "Индексировано", updated: "18.08.2026", content: "# Программа ПЭК Березниковского ЛПУМГ\n\n## Назначение\nПрограмма определяет порядок производственного экологического контроля на объекте.\n\n## Контрольные действия\nРезультаты измерений, журналы и ответственные лица должны быть доступны для проверки.\n\n> Связанные разделы: 1.1, 2.2 и 3.2." },
                        { name: "Приказ о проведении инвентаризации.md", type: "file", status: "Не индексировано", updated: "17.08.2026", content: "# Приказ о проведении инвентаризации\n\n## Задача\nПровести инвентаризацию источников выбросов до 30.09.2026.\n\n## Ответственный\nНазначен инженер по охране окружающей среды.\n\n> Документ подготовлен для демонстрации обработки ОРД." }
                    ]
                },
                { name: "README.md", type: "file", status: "Индексировано", updated: "21.08.2026", content: "# Рабочая область базы знаний\n\nЭта папка содержит демонстрационные Markdown-документы.\n\nRAG использует индексированные фрагменты документов для поиска оснований и подготовки ответов ИИ-консультанта.\n\nКаждый документ можно связать с разделом классификатора и пунктом чек-листа." }
            ]
        };
    </script>
    <script src="~/js/knowledge-base.js" asp-append-version="true"></script>
}
