@page "/Facilities/Card/{id?}"
@{
    var id = (RouteData.Values["id"] as string ?? "bereznikovskoe").ToLowerInvariant();
    var facility = id switch
    {
        "bardymskoe" => CreateBardymskoe(),
        "votkinskoe" => CreateVotkinskoe(),
        _ => CreateBereznikovskoe()
    };

    ViewData["Title"] = facility.ShortName;
    ViewData["Nav"] = "Facilities";
    ViewData["Breadcrumb"] = $"Объекты \\ Карточка \\ {facility.ShortName}";
}

<div class="page-actions mb-3">
    <a class="btn btn-outline-primary" asp-page="/Facilities">Назад к объектам</a>
    <a class="btn btn-primary" asp-page="/Checklists/New">Создать чек-лист</a>
</div>

<section class="soft-panel p-4 mb-4">
    <div class="d-flex flex-wrap justify-content-between gap-3 mb-4">
        <div>
            <h1 class="section-title h2 mb-1">@facility.ShortName</h1>
            <p class="muted-note mb-0">@facility.FullName</p>
        </div>
        <span class="badge text-bg-success align-self-start">Действующий объект</span>
    </div>

    <dl class="row g-3 mb-0">
        <div class="col-md-3"><dt class="small text-muted">Тип объекта</dt><dd class="fw-semibold mb-0">@facility.Type</dd></div>
        <div class="col-md-3"><dt class="small text-muted">Филиал</dt><dd class="fw-semibold mb-0">@facility.Branch</dd></div>
        <div class="col-md-3"><dt class="small text-muted">Категория НВОС</dt><dd class="fw-semibold mb-0">@facility.Category</dd></div>
        <div class="col-md-3"><dt class="small text-muted">Ответственное лицо</dt><dd class="fw-semibold mb-0">@facility.Responsible</dd></div>
    </dl>
</section>

<section class="row g-4">
    <div class="col-lg-7">
        <div class="soft-panel p-4 h-100">
            <h2 class="section-title h4 mb-3">Основная информация</h2>
            <dl class="row g-3 mb-4">
                <div class="col-md-6"><dt class="small text-muted">Регион</dt><dd class="mb-0">@facility.Region</dd></div>
                <div class="col-md-6"><dt class="small text-muted">Особые природные зоны</dt><dd class="mb-0">@facility.SpecialZones</dd></div>
                <div class="col-12"><dt class="small text-muted">Адрес</dt><dd class="mb-0">@facility.Address</dd></div>
                <div class="col-md-6"><dt class="small text-muted">Телефон</dt><dd class="mb-0">Не указано</dd></div>
                <div class="col-md-6"><dt class="small text-muted">E-mail</dt><dd class="mb-0">Не указан</dd></div>
            </dl>

            <h3 class="h6">Функциональные зоны</h3>
            <div class="pill-group mb-4">
                @foreach (var item in facility.Zones) { <span class="classifier-chip">@item</span> }
            </div>

            <h3 class="h6">Группы экологических аспектов</h3>
            <div class="pill-group">
                @foreach (var item in facility.EnvironmentalAspects) { <span class="classifier-chip">@item</span> }
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <aside class="soft-panel p-4 h-100">
            <h2 class="section-title h4 mb-3">Технологические характеристики</h2>
            <h3 class="h6">Перечень оборудования</h3>
            <ul class="mb-4 ps-3">
                @foreach (var item in facility.Equipment) { <li class="mb-2">@item</li> }
            </ul>
            <dl class="row g-3 mb-0">
                <div class="col-12"><dt class="small text-muted">Газоочистные установки</dt><dd class="mb-0">@facility.GasTreatment</dd></div>
                <div class="col-12"><dt class="small text-muted">Очистные сооружения</dt><dd class="mb-0">@facility.TreatmentFacilities</dd></div>
                <div class="col-12"><dt class="small text-muted">Источники водоснабжения</dt><dd class="mb-0">@facility.WaterSupply</dd></div>
            </dl>
        </aside>
    </div>
</section>

<section class="row g-4 mt-1">
    <div class="col-lg-7">
        <div class="soft-panel p-4 h-100">
            <h2 class="section-title h4 mb-3">Источники выбросов</h2>
            <ul class="mb-0 ps-3">
                @foreach (var item in facility.EmissionSources) { <li class="mb-2">@item</li> }
            </ul>
        </div>
    </div>
    <div class="col-lg-5">
        <aside class="soft-panel p-4 h-100">
            <h2 class="section-title h4 mb-3">Документация и разрешения</h2>
            <h3 class="h6">Разрешительная документация</h3>
            <ul class="mb-4 ps-3">
                @foreach (var item in facility.Permits) { <li class="mb-2">@item</li> }
            </ul>
            <dl class="row g-3 mb-0">
                <div class="col-12"><dt class="small text-muted">Программа ПЭК</dt><dd class="mb-0">@facility.PecProgram</dd></div>
                <div class="col-12"><dt class="small text-muted">ПНООЛР</dt><dd class="mb-0">@facility.WasteStandard</dd></div>
                <div class="col-12"><dt class="small text-muted">Проект СЗЗ</dt><dd class="mb-0">@facility.SanitaryZoneProject</dd></div>
            </dl>
        </aside>
    </div>
</section>

