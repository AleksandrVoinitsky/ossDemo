    private static readonly string[] DefaultAspects = ["Выбросы в атмосферный воздух", "Сбросы в водные объекты", "Образование и обращение с отходами", "Потребление природных ресурсов", "Воздействие на земельные ресурсы и почвы", "Аварийные и залповые воздействия"];
    private static readonly string[] DefaultEmissions = ["Выбросы от газотурбинной установки (ГТУ)", "Дымовая труба газотурбинного двигателя (ГТД)", "Выбросы от котельных установок", "Выбросы от дизельной электростанции (ДЭС)", "Сбросы газа через факельную установку", "Неорганизованные утечки через уплотнения арматуры", "Продувка участков газопровода при ремонте или освидетельствовании", "Выбросы от склада ГСМ"];

    private static FacilityCard CreateBardymskoe() => new(
        "Бардымское линейное производственное управление магистральных газопроводов", "Бардымское ЛПУМГ", "Линейная часть магистрального газопровода", "ООО «Газпром трансгаз Чайковский»", "I категория", "Пермский край", "618150, Пермский край, Бардымский район, с. Барда", "Отсутствуют", "Иванов И.И., инженер по ООС филиала", DefaultZones, DefaultAspects,
        ["Газоперекачивающие агрегаты (ГПА)", "Компрессорные цеха КЦ № 3, № 4, № 6", "ГРС «Орда», «Усть-Кишерты», «Голдыревский», «Уинское», «Барда», «Большая Ась»", "Узлы запуска и приёма внутритрубных устройств", "Запорно-регулирующая арматура", "Котельные установки на ГРС", "Резервные ДЭС", "АГНКС"],
        "Не указано", "Не указано", "Не указано", DefaultEmissions,
        ["КЭР для объектов I категории НВОС", "Разрешение на выбросы загрязняющих веществ", "Разрешение на сбросы", "ПЛАРН", "Лицензия на эксплуатацию взрывопожароопасных объектов"], "Не указано", "Не указано", "Не указано");

    private static FacilityCard CreateBereznikovskoe() => new(
        "Березниковское линейное производственное управление магистральных газопроводов", "Березниковское ЛПУМГ", "Линейная часть магистрального газопровода", "ООО «Газпром трансгаз Чайковский»", "I категория", "Пермский край", "Пермский край, г. Березники, промзона", "Водоохранная зона реки Кама", "Иванов И.И., инженер по ООС филиала",
        ["Компрессорный цех", "Газораспределительный пункт (ГРП)", "Котельная", "Очистные сооружения канализационные (КОС/ЛОС)", "Дизельная электростанция (ДЭС)", "Склад ГСМ", "Санитарно-защитная зона (СЗЗ)", "Артезианская скважина", "Административное здание"], DefaultAspects,
        ["Газоперекачивающие агрегаты ГПА-1, ГПА-2", "Факельные устройства", "Артезианские скважины — 2 шт.", "Дизель-генераторы"],
