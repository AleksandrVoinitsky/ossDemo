    private sealed record FacilityCard(string FullName, string ShortName, string Type, string Branch, string Category, string Region, string Address, string SpecialZones, string Responsible, string[] Zones, string[] EnvironmentalAspects, string[] Equipment, string GasTreatment, string TreatmentFacilities, string WaterSupply, string[] EmissionSources, string[] Permits, string PecProgram, string WasteStandard, string SanitaryZoneProject);
}
