@page "/Facilities/Card/{id?}"
@{
    var id = RouteData.Values["id"] as string ?? "bereznikovskoe";
    ViewData["Title"] = "Карточка объекта";
    ViewData["Nav"] = "Facilities";
    ViewData["Breadcrumb"] = "Объекты \\ Карточка";
}

<div class="page-actions mb-3 d-flex flex-wrap justify-content-between gap-2">
    <a class="btn btn-outline-primary" asp-page="/Facilities">Назад к объектам</a>
    <div class="d-flex gap-2"><a class="btn btn-outline-primary" href="/Facilities/Edit/@id">Редактировать</a><a class="btn btn-primary" asp-page="/Checklists/New">Создать чек-лист</a></div>
</div>

<div data-facility-card data-facility-slug="@id">
    <section class="soft-panel p-4 mb-4">
        <div class="d-flex flex-wrap justify-content-between gap-3 mb-4"><div><h1 class="section-title h2 mb-1" data-field="shortName">Загрузка…</h1><p class="muted-note mb-0" data-field="fullName"></p></div><span class="badge text-bg-success align-self-start">Действующий объект</span></div>
        <dl class="row g-3 mb-0"><div class="col-md-3"><dt class="small text-muted">Тип объекта</dt><dd class="fw-semibold mb-0" data-field="type"></dd></div><div class="col-md-3"><dt class="small text-muted">Филиал</dt><dd class="fw-semibold mb-0" data-field="branch"></dd></div><div class="col-md-3"><dt class="small text-muted">Категория НВОС</dt><dd class="fw-semibold mb-0" data-field="category"></dd></div><div class="col-md-3"><dt class="small text-muted">Ответственное лицо</dt><dd class="fw-semibold mb-0" data-field="responsible"></dd></div></dl>
    </section>
    <section class="row g-4"><div class="col-lg-7"><div class="soft-panel p-4 h-100"><h2 class="section-title h4 mb-3">Основная информация</h2><dl class="row g-3 mb-4"><div class="col-md-6"><dt class="small text-muted">Регион</dt><dd data-field="region"></dd></div><div class="col-md-6"><dt class="small text-muted">Особые природные зоны</dt><dd data-field="specialZones"></dd></div><div class="col-12"><dt class="small text-muted">Адрес</dt><dd data-field="address"></dd></div><div class="col-md-6"><dt class="small text-muted">Телефон</dt><dd data-field="phone"></dd></div><div class="col-md-6"><dt class="small text-muted">E-mail</dt><dd data-field="email"></dd></div></dl><h3 class="h6">Функциональные зоны</h3><div class="pill-group mb-4" data-list="zones"></div><h3 class="h6">Группы экологических аспектов</h3><div class="pill-group" data-list="environmentalAspects"></div></div></div>
    <div class="col-lg-5"><aside class="soft-panel p-4 h-100"><h2 class="section-title h4 mb-3">Технологические характеристики</h2><h3 class="h6">Перечень оборудования</h3><ul class="mb-4 ps-3" data-lines="equipment"></ul><dl class="row g-3 mb-0"><div class="col-12"><dt class="small text-muted">Газоочистные установки</dt><dd data-field="gasTreatment"></dd></div><div class="col-12"><dt class="small text-muted">Очистные сооружения</dt><dd data-field="treatmentFacilities"></dd></div><div class="col-12"><dt class="small text-muted">Источники водоснабжения</dt><dd data-field="waterSupply"></dd></div></dl></aside></div></section>
    <section class="row g-4 mt-1"><div class="col-lg-7"><div class="soft-panel p-4 h-100"><h2 class="section-title h4 mb-3">Источники выбросов</h2><ul class="mb-0 ps-3" data-lines="emissionSources"></ul></div></div><div class="col-lg-5"><aside class="soft-panel p-4 h-100"><h2 class="section-title h4 mb-3">Документация и разрешения</h2><h3 class="h6">Разрешительная документация</h3><ul class="mb-4 ps-3" data-lines="permits"></ul><dl class="row g-3 mb-0"><div class="col-12"><dt class="small text-muted">Программа ПЭК</dt><dd data-field="pecProgram"></dd></div><div class="col-12"><dt class="small text-muted">ПНООЛР</dt><dd data-field="wasteStandard"></dd></div><div class="col-12"><dt class="small text-muted">Проект СЗЗ</dt><dd data-field="sanitaryZoneProject"></dd></div></dl></aside></div></section>
    <div class="alert alert-danger mt-4" data-facility-card-error hidden></div>
</div>

@section Scripts { <script src="~/js/facility-card.js" asp-append-version="true"></script> }
