@page
@{
    ViewData["Title"] = "Классификатор";
    ViewData["Nav"] = "Classifier";
}

<section class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
    <div>
        <span class="badge text-bg-primary mb-2">Таксономия требований</span>
        <h1 class="section-title mb-1">Классификатор критериев контроля</h1>
        <p class="muted-note mb-0">Отдельный структурированный справочник: не хранится как обычный RAG-документ.</p>
    </div>
    <button class="btn btn-outline-primary" data-export-demo>Импортировать XLSX</button>
</section>

<section class="row g-4">
    <div class="col-lg-5">
        <div class="soft-panel p-4 h-100">
            <div class="d-flex justify-content-between mb-3"><h2 class="h4 section-title">Версия v2026.01</h2><span class="badge text-bg-success">активна</span></div>
            <div class="list-group">
                <div class="list-group-item"><strong>1 Общие вопросы</strong><div class="small text-muted">документы, ответственность, ПЭК</div></div>
                <div class="list-group-item"><strong>2 Охрана атмосферного воздуха</strong><div class="small text-muted">источники выбросов, ГОУ, инвентаризация</div></div>
                <div class="list-group-item"><strong>3 Охрана водных объектов</strong><div class="small text-muted">водопользование, сбросы, КОС</div></div>
                <div class="list-group-item"><strong>4 Обращение с отходами</strong><div class="small text-muted">ПНООЛР, паспорта, места накопления</div></div>
                <div class="list-group-item"><strong>5 Землепользование</strong><div class="small text-muted">участки, рекультивация, загрязнение</div></div>
                <div class="list-group-item"><strong>6 Недропользование</strong><div class="small text-muted">артезианские скважины, лицензии</div></div>
                <div class="list-group-item"><strong>7 ООПТ, растительный и животный мир</strong><div class="small text-muted">особые зоны и ограничения</div></div>
            </div>
        </div>
    </div>
    <div class="col-lg-7">
        <div class="soft-panel p-4 mb-4">
            <h2 class="h4 section-title">Карточка раздела 4.3</h2>
            <p class="mb-2"><strong>Путь:</strong> 4 Обращение с отходами → 4.3 Нормативы образования отходов и лимиты размещения</p>
            <p class="muted-note">Используется для пунктов о наличии утвержденного ПНООЛР, соответствии фактических объемов лимитам и корректности мест накопления.</p>
            <div class="pill-group"><span class="source-chip">ФЗ-89 ст. 11</span><span class="source-chip">Приказ Минприроды №792</span><span class="source-chip">СТО 16-005-2025 п. 5.3.2</span></div>
        </div>
        <div class="soft-panel p-4">
            <h2 class="h4 section-title">Сравнение версий</h2>
            <div class="table-responsive"><table class="table align-middle"><thead><tr><th>Изменение</th><th>Раздел</th><th>Действие</th></tr></thead><tbody>
                <tr><td><span class="badge text-bg-success">добавлен</span></td><td>3.4 Производственный контроль сточных вод</td><td>перепроверить привязки БЗ</td></tr>
                <tr><td><span class="badge text-bg-warning">изменен</span></td><td>4.3 ПНООЛР</td><td>пересчитать шаблоны чек-листов</td></tr>
                <tr><td><span class="badge text-bg-secondary">алиас</span></td><td>Атмосфера / атмосферный контроль</td><td>сохранить сопоставление</td></tr>
            </tbody></table></div>
        </div>
    </div>
</section>
