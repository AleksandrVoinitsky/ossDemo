@page
@{
    ViewData["Title"] = "Классификатор";
    ViewData["Nav"] = "Classifier";
    ViewData["Breadcrumb"] = "Классификатор \\ Критерии контроля";
}

<section class="classifier-hero mb-4">
    <div>
        <span class="classifier-eyebrow">Основа формирования чек-листов</span>
        <h1 class="display-6 mb-2">Классификатор критериев контроля</h1>
        <p class="mb-0">Живое дерево связывает карточки объектов, актуальную базу знаний и историю проверок.</p>
    </div>
    <div class="classifier-hero-stats" aria-label="Сводка классификатора">
        <div><strong data-classifier-version>—</strong><span>версия</span></div>
        <div><strong data-classifier-section-count>—</strong><span>разделов</span></div>
        <div><strong data-classifier-criterion-count>—</strong><span>критериев</span></div>
    </div>
</section>

<section class="classifier-workspace" data-classifier-app>
    <div class="soft-panel classifier-tree-panel">
        <div class="classifier-panel-header">
            <div><h2 class="h4 section-title mb-1">Дерево критериев</h2><p class="muted-note mb-0">Выберите узел для просмотра и настройки.</p></div>
            <button class="btn btn-primary btn-sm" type="button" data-classifier-create>Добавить критерий</button>
        </div>
        <label class="classifier-search">
            <span class="visually-hidden">Поиск по классификатору</span>
            <input class="form-control" type="search" placeholder="Код, проверка или ключевое слово" data-classifier-search />
        </label>
        <div class="classifier-tree" role="tree" data-classifier-tree>
            <div class="classifier-loading"><span class="spinner-border spinner-border-sm" aria-hidden="true"></span> Загружаем структуру из БД…</div>
        </div>
    </div>

    <aside class="classifier-detail-panel">
        <div class="soft-panel classifier-card classifier-editor" data-classifier-editor>
            <div class="classifier-editor-empty" data-classifier-empty>
                <span class="classifier-empty-icon" aria-hidden="true">↳</span>
                <h2 class="h4 section-title">Выберите критерий</h2>
                <p class="muted-note mb-0">Здесь появятся формулировка, правила связи с карточкой и поисковые подсказки.</p>
            </div>
            <form data-classifier-form hidden>
                <div class="d-flex flex-wrap justify-content-between gap-2 mb-3">
                    <div><span class="badge text-bg-primary" data-classifier-card-code>—</span><h2 class="h4 section-title mt-2 mb-0" data-classifier-card-title>Карточка критерия</h2></div>
                    <div class="form-check form-switch"><input class="form-check-input" type="checkbox" id="classifierActive" data-classifier-active><label class="form-check-label" for="classifierActive">Активен</label></div>
                </div>
                <div class="row g-3">
                    <div class="col-md-4"><label class="form-label" for="classifierSection">Раздел</label><select class="form-select" id="classifierSection" data-classifier-section></select></div>
                    <div class="col-md-3"><label class="form-label" for="classifierCode">Код</label><input class="form-control" id="classifierCode" data-classifier-code /></div>
                    <div class="col-md-5"><label class="form-label" for="classifierPosition">Порядок</label><input class="form-control" id="classifierPosition" type="number" min="0" data-classifier-position /></div>
                    <div class="col-12"><label class="form-label" for="classifierCheck">Проверочное действие</label><textarea class="form-control classifier-primary-field" id="classifierCheck" rows="3" data-classifier-check></textarea></div>
                    <div class="col-12"><label class="form-label" for="classifierRisk">Исходная формулировка риска</label><textarea class="form-control" id="classifierRisk" rows="4" data-classifier-risk></textarea></div>
                    <div class="col-12"><label class="form-label" for="classifierTerms">Поисковые термины</label><textarea class="form-control" id="classifierTerms" rows="3" data-classifier-terms></textarea></div>
                    <div class="col-12"><label class="form-label" for="classifierRules">Связь с карточкой объекта</label><textarea class="form-control font-monospace" id="classifierRules" rows="4" data-classifier-rules placeholder="поле | contains-any | значение 1, значение 2"></textarea><div class="form-text">Одно правило на строку: поле | оператор | значения через запятую.</div></div>
                    <div class="col-12"><label class="form-label" for="classifierHints">Подсказки нормативных источников</label><textarea class="form-control" id="classifierHints" rows="2" data-classifier-hints></textarea></div>
                </div>
                <div class="classifier-usage-grid mt-4">
                    <div><span>Исторических применений</span><strong data-classifier-usage>0</strong></div>
                    <div><span>Последние источники</span><strong data-classifier-sources>Будут собраны после запусков</strong></div>
                </div>
                <div class="alert mt-3" data-classifier-message hidden></div>
                <div class="d-flex flex-wrap justify-content-between gap-2 mt-4">
                    <button class="btn btn-outline-danger" type="button" data-classifier-delete>Отключить</button>
                    <button class="btn btn-success" type="submit">Сохранить критерий</button>
                </div>
            </form>
        </div>
    </aside>
</section>

@section Scripts { <script src="~/js/classifier.js" asp-append-version="true"></script> }
