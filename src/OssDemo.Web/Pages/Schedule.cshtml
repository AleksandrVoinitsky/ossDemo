@page
@{
    ViewData["Title"] = "График проверок";
    ViewData["Nav"] = "Schedule";
    ViewData["Breadcrumb"] = "График \\ Календарь событий";
}

@section Styles {
    <link rel="preload" href="~/lib/fullcalendar/index.global.min.js" as="script" />
}

<section class="soft-panel schedule-toolbar p-3 p-lg-4 mb-4" aria-label="Фильтры календаря">
    <div class="row g-3 align-items-end">
        <div class="col-lg-4">
            <label class="form-label" for="scheduleSearch">Объект или ответственный</label>
            <input id="scheduleSearch" class="form-control" value="" placeholder="Например: Березниковское" data-schedule-search aria-label="Поиск по графику" />
        </div>
        <div class="col-md-4 col-lg-3">
            <label class="form-label" for="scheduleStatus">Статус</label>
            <select id="scheduleStatus" class="form-select" data-schedule-status>
                <option value="all">Все статусы</option>
                <option value="ready">Готово к генерации</option>
                <option value="profile">Профиль требует доработки</option>
                <option value="missing">Требует создания</option>
                <option value="control">Контрольный срок</option>
                <option value="draft">В подготовке</option>
            </select>
        </div>
        <div class="col-md-4 col-lg-3">
            <label class="form-label" for="scheduleCategory">Тип события</label>
            <select id="scheduleCategory" class="form-select" data-schedule-category>
                <option value="all">Все типы</option>
                <option value="inspection">Проверка</option>
                <option value="documents">ОРД и документы</option>
                <option value="generation">Генерация чек-листа</option>
                <option value="control">Контроль нарушения</option>
            </select>
        </div>
        <div class="col-md-4 col-lg-2">
            <button class="btn btn-outline-secondary w-100" type="button" data-schedule-reset>Сбросить</button>
        </div>
    </div>
    <div class="d-flex flex-wrap gap-2 mt-3" aria-label="Легенда статусов">
        <span class="schedule-legend-item"><span class="legend-dot ready"></span>Готово</span>
        <span class="schedule-legend-item"><span class="legend-dot profile"></span>Доработать профиль</span>
        <span class="schedule-legend-item"><span class="legend-dot missing"></span>Требует создания</span>
        <span class="schedule-legend-item"><span class="legend-dot control"></span>Контрольный срок</span>
        <span class="schedule-legend-item"><span class="legend-dot draft"></span>В подготовке</span>
    </div>
</section>

<section class="schedule-workspace">
    <div class="soft-panel schedule-calendar-panel p-3 p-lg-4">
        <div class="d-flex flex-wrap justify-content-between gap-3 mb-3">
            <div>
                <h2 class="h4 section-title mb-1">План-график</h2>
                <p class="muted-note mb-0" data-schedule-result>Загружаем календарь...</p>
            </div>
            <span class="badge text-bg-info align-self-start">FullCalendar</span>
        </div>
        <div id="scheduleCalendar" class="schedule-calendar" aria-label="Календарь проверок"></div>
    </div>

    <aside class="schedule-side-stack" aria-label="Ближайшие события">
        <div class="soft-panel p-3 p-lg-4">
            <div class="d-flex justify-content-between gap-3 mb-3">
                <div>
                    <h2 class="h4 section-title mb-1">Ближайшие события</h2>
                    <p class="muted-note mb-0">Список синхронизирован с фильтрами.</p>
                </div>
                <span class="badge text-bg-secondary" data-schedule-upcoming-count>0</span>
            </div>
            <div class="schedule-upcoming-list" data-schedule-upcoming></div>
        </div>
    </aside>
</section>

@section VendorScripts {
    <script src="~/lib/fullcalendar/index.global.min.js"></script>
    <script src="~/lib/fullcalendar/locales-all.global.min.js"></script>
}

@section Scripts {
    <script src="~/js/schedule-calendar.js" asp-append-version="true"></script>
}
