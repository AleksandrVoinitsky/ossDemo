<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RagifyModelDirectory Condition="'$(RagifyModelDirectory)' == ''">$(MSBuildProjectDirectory)\..\..\..\paraphrase-multilingual-MiniLM-L12-v2</RagifyModelDirectory>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" Version="10.0.1" />
    <PackageReference Include="RAGify" Version="3.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\knowledge-inbox\**\*">
      <Link>knowledge-inbox\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="$(RagifyModelDirectory)\onnx\model_O1.onnx" Condition="Exists('$(RagifyModelDirectory)\onnx\model_O1.onnx')">
      <Link>Models\paraphrase-multilingual-MiniLM-L12-v2\model_O1.onnx</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="$(RagifyModelDirectory)\tokenizer.json" Condition="Exists('$(RagifyModelDirectory)\tokenizer.json')">
      <Link>Models\paraphrase-multilingual-MiniLM-L12-v2\tokenizer.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OssDemo.Rag.Tests" />
  </ItemGroup>

</Project>
